# cli.nox — Command-line interface definitions, parsing engine, help generator, and application runner.

import nox.strings
import nox.os
import core
from core import Console, Style, cell_width
import arguments
from arguments import Argument, TYPE_STR, TYPE_INT, TYPE_FLOAT, TYPE_BOOL
import options
from options import Option
import errors
from errors import CliError, UsageError, UnknownOptionError, MissingArgumentError, MissingOptionValueError, InvalidTypeError, CommandNotFoundError

class CliContext:
    values: dict[str, str]
    variadic_values: list[str]
    flags: dict[str, bool]

    def __init__(self: CliContext) -> None:
        self.values = {}
        self.variadic_values = []
        self.flags = {}

    def set_value(self: CliContext, key: str, val: str) -> None:
        self.values[key] = val

    def set_flag(self: CliContext, key: str, val: bool) -> None:
        self.flags[key] = val

    def get_str(self: CliContext, key: str, fallback: str = "") -> str:
        if key in self.values:
            return self.values[key]
        return fallback

    def get_int(self: CliContext, key: str, fallback: int = 0) -> int:
        if key in self.values:
            try:
                return int(nox.strings.trim(self.values[key]))
            except ValueError:
                return fallback
        return fallback

    def get_float(self: CliContext, key: str, fallback: float = 0.0) -> float:
        if key in self.values:
            try:
                return float(nox.strings.trim(self.values[key]))
            except ValueError:
                return fallback
        return fallback

    def get_bool(self: CliContext, key: str, fallback: bool = False) -> bool:
        if key in self.flags:
            return self.flags[key]
        if key in self.values:
            v: str = nox.strings.lower(self.values[key])
            if v == "true" or v == "1" or v == "yes":
                return True
            if v == "false" or v == "0" or v == "no":
                return False
        return fallback

class Command:
    name: str
    description: str
    arguments: list[Argument]
    options: list[Option]
    subcommands: list[Command]

    def __init__(self: Command, name: str, description: str = "") -> None:
        self.name = name
        self.description = description
        self.arguments = []
        self.options = []
        self.subcommands = []

    def add_argument(
        self: Command,
        name: str,
        arg_type: int = 1,
        required: bool = True,
        default_val: str = "",
        help: str = "",
        variadic: bool = False
    ) -> Argument:
        arg: Argument = Argument(name, arg_type, required, default_val, help, variadic)
        self.arguments.append(arg)
        return arg

    def add_option(
        self: Command,
        name: str,
        short_name: str = "",
        opt_type: int = 1,
        is_flag: bool = False,
        required: bool = False,
        default_val: str = "",
        help: str = ""
    ) -> Option:
        opt: Option = Option(name, short_name, opt_type, is_flag, required, default_val, help)
        self.options.append(opt)
        return opt

    def add_subcommand(self: Command, sub: Command) -> None:
        self.subcommands.append(sub)

    def get_subcommand(self: Command, name: str) -> Command | None:
        i: int = 0
        while i < len(self.subcommands):
            if self.subcommands[i].name == name:
                return self.subcommands[i]
            i = i + 1
        return None

    def find_option_by_long(self: Command, name: str) -> Option | None:
        i: int = 0
        while i < len(self.options):
            if self.options[i].name == name:
                return self.options[i]
            i = i + 1
        return None

    def find_option_by_short(self: Command, short_name: str) -> Option | None:
        i: int = 0
        while i < len(self.options):
            if self.options[i].short_name == short_name:
                return self.options[i]
            i = i + 1
        return None

    def format_help(self: Command, console: Console) -> str:
        lines: list[str] = []
        bold: Style = Style("", "", True)
        dim: Style = Style("", "", False, True)

        # 1. Usage synopsis
        usage_str: str = "Usage: " + self.name
        if len(self.options) > 0:
            usage_str = usage_str + " [OPTIONS]"
        if len(self.subcommands) > 0:
            usage_str = usage_str + " COMMAND"
        i: int = 0
        while i < len(self.arguments):
            arg: Argument = self.arguments[i]
            if arg.required:
                usage_str = usage_str + " <" + arg.name + ">"
            else:
                usage_str = usage_str + " [" + arg.name + "]"
            if arg.variadic:
                usage_str = usage_str + "..."
            i = i + 1

        if console.options.supports_color:
            lines.append(bold.apply(usage_str))
        else:
            lines.append(usage_str)

        lines.append("")

        # 2. Description
        if len(self.description) > 0:
            lines.append("  " + self.description)
            lines.append("")

        # 3. Positional Arguments
        if len(self.arguments) > 0:
            lines.append("Arguments:")
            j: int = 0
            while j < len(self.arguments):
                a: Argument = self.arguments[j]
                arg_label: str = "  " + a.name
                if not a.required and len(a.default_val) > 0:
                    arg_label = arg_label + " (default: " + a.default_val + ")"
                if len(a.help) > 0:
                    arg_label = nox.strings.pad_right(arg_label, 26, " ") + a.help
                lines.append(arg_label)
                j = j + 1
            lines.append("")

        # 4. Options
        lines.append("Options:")
        # Built-in help option display
        lines.append(nox.strings.pad_right("  -h, --help", 26, " ") + "Show this message and exit")

        k: int = 0
        while k < len(self.options):
            opt: Option = self.options[k]
            opt_label: str = "  "
            if len(opt.short_name) > 0:
                opt_label = opt_label + "-" + opt.short_name + ", "
            else:
                opt_label = opt_label + "    "
            opt_label = opt_label + "--" + opt.name
            if not opt.is_flag:
                opt_label = opt_label + " <value>"

            extra_info: str = opt.help
            if len(opt.default_val) > 0:
                if len(extra_info) > 0:
                    extra_info = extra_info + " [default: " + opt.default_val + "]"
                else:
                    extra_info = "[default: " + opt.default_val + "]"

            if len(extra_info) > 0:
                opt_label = nox.strings.pad_right(opt_label, 26, " ") + extra_info
            lines.append(opt_label)
            k = k + 1

        # 5. Subcommands
        if len(self.subcommands) > 0:
            lines.append("")
            lines.append("Commands:")
            s: int = 0
            while s < len(self.subcommands):
                sub: Command = self.subcommands[s]
                sub_label: str = "  " + sub.name
                if len(sub.description) > 0:
                    sub_label = nox.strings.pad_right(sub_label, 26, " ") + sub.description
                lines.append(sub_label)
                s = s + 1

        return nox.strings.join(lines, "\n")

class CliResult:
    command: Command
    context: CliContext
    exit_code: int
    help_requested: bool
    version_requested: bool
    error_message: str

    def __init__(
        self: CliResult,
        command: Command,
        context: CliContext,
        exit_code: int = 0,
        help_requested: bool = False,
        version_requested: bool = False,
        error_message: str = ""
    ) -> None:
        self.command = command
        self.context = context
        self.exit_code = exit_code
        self.help_requested = help_requested
        self.version_requested = version_requested
        self.error_message = error_message

    def is_success(self: CliResult) -> bool:
        return self.exit_code == 0

class CliApp:
    root: Command
    version: str
    console: Console

    def __init__(self: CliApp, root: Command, version: str = "0.1.0", console: Console | None = None) -> None:
        self.root = root
        self.version = version
        if console is not None:
            self.console = console
        else:
            self.console = Console()

    def parse(self: CliApp, raw_args: list[str]) -> CliResult:
        current_cmd: Command = self.root
        tokens: list[str] = raw_args
        ctx: CliContext = CliContext()

        # 1. Resolve subcommands
        while len(tokens) > 0:
            first_tok: str = tokens[0]
            if first_tok == "-h" or first_tok == "--help":
                return CliResult(current_cmd, ctx, 0, True, False, "")
            if first_tok == "-V" or first_tok == "--version":
                return CliResult(current_cmd, ctx, 0, False, True, "")
            if not nox.strings.starts_with(first_tok, "-"):
                sub: Command | None = current_cmd.get_subcommand(first_tok)
                if sub is not None:
                    current_cmd = sub
                    # Pop subcommand token
                    sub_tail: list[str] = []
                    idx: int = 1
                    while idx < len(tokens):
                        sub_tail.append(tokens[idx])
                        idx = idx + 1
                    tokens = sub_tail
                    continue
            break

        # Check for help/version in remaining tokens
        ti: int = 0
        while ti < len(tokens):
            if tokens[ti] == "-h" or tokens[ti] == "--help":
                return CliResult(current_cmd, ctx, 0, True, False, "")
            if tokens[ti] == "-V" or tokens[ti] == "--version":
                return CliResult(current_cmd, ctx, 0, False, True, "")
            ti = ti + 1

        # 2. Parse options and positionals
        pos_tokens: list[str] = []
        i: int = 0
        end_of_options: bool = False

        while i < len(tokens):
            tok: str = tokens[i]

            if end_of_options:
                pos_tokens.append(tok)
                i = i + 1
                continue

            if tok == "--":
                end_of_options = True
                i = i + 1
                continue

            if nox.strings.starts_with(tok, "--"):
                # Long option
                opt_str: str = tok[2:]
                opt_name: str = opt_str
                opt_val: str | None = None

                eq_idx: int = nox.strings.index_of(opt_str, "=")
                if eq_idx >= 0:
                    opt_name = opt_str[:eq_idx]
                    opt_val = opt_str[eq_idx + 1:]

                opt_def: Option | None = current_cmd.find_option_by_long(opt_name)
                if opt_def is None:
                    return CliResult(current_cmd, ctx, 2, False, False, "Unknown option: --" + opt_name)

                if opt_def.is_flag:
                    if opt_val is not None:
                        # e.g. --flag=false
                        v_lower: str = nox.strings.lower(opt_val)
                        ctx.set_flag(opt_def.name, v_lower == "true" or v_lower == "1")
                    else:
                        ctx.set_flag(opt_def.name, True)
                else:
                    val_to_use: str = ""
                    if opt_val is not None:
                        val_to_use = opt_val
                    else:
                        if i + 1 < len(tokens):
                            i = i + 1
                            val_to_use = tokens[i]
                        else:
                            return CliResult(current_cmd, ctx, 2, False, False, "Option --" + opt_name + " requires a value")
                    ctx.set_value(opt_def.name, val_to_use)

                i = i + 1
                continue

            if nox.strings.starts_with(tok, "-") and len(tok) > 1:
                # Check for negative number
                first_ch: str = tok[1]
                b_val: int = nox.strings.byte_at(first_ch, 0)
                if b_val >= 48 and b_val <= 57: # '0' to '9'
                    pos_tokens.append(tok)
                    i = i + 1
                    continue

                short_str: str = tok[1:]
                short_def: Option | None = current_cmd.find_option_by_short(short_str)
                if short_def is None:
                    return CliResult(current_cmd, ctx, 2, False, False, "Unknown option: -" + short_str)

                if short_def.is_flag:
                    ctx.set_flag(short_def.name, True)
                else:
                    if i + 1 < len(tokens):
                        i = i + 1
                        ctx.set_value(short_def.name, tokens[i])
                    else:
                        return CliResult(current_cmd, ctx, 2, False, False, "Option -" + short_str + " requires a value")

                i = i + 1
                continue

            pos_tokens.append(tok)
            i = i + 1

        # 3. Match positional arguments
        arg_idx: int = 0
        p_idx: int = 0
        while arg_idx < len(current_cmd.arguments):
            arg_def: Argument = current_cmd.arguments[arg_idx]
            if arg_def.variadic:
                while p_idx < len(pos_tokens):
                    ctx.variadic_values.append(pos_tokens[p_idx])
                    p_idx = p_idx + 1
                break
            else:
                if p_idx < len(pos_tokens):
                    val_token: str = pos_tokens[p_idx]
                    # Validate types
                    if arg_def.arg_type == TYPE_INT:
                        try:
                            discard_i: int = int(nox.strings.trim(val_token))
                        except ValueError:
                            return CliResult(current_cmd, ctx, 2, False, False, "Invalid integer for argument '" + arg_def.name + "': " + val_token)
                    elif arg_def.arg_type == TYPE_FLOAT:
                        try:
                            discard_f: float = float(nox.strings.trim(val_token))
                        except ValueError:
                            return CliResult(current_cmd, ctx, 2, False, False, "Invalid float for argument '" + arg_def.name + "': " + val_token)

                    ctx.set_value(arg_def.name, val_token)
                    p_idx = p_idx + 1
                else:
                    if arg_def.required:
                        if len(arg_def.default_val) > 0:
                            ctx.set_value(arg_def.name, arg_def.default_val)
                        else:
                            return CliResult(current_cmd, ctx, 2, False, False, "Missing required argument: <" + arg_def.name + ">")
                    else:
                        if len(arg_def.default_val) > 0:
                            ctx.set_value(arg_def.name, arg_def.default_val)
            arg_idx = arg_idx + 1

        # Reject unexpected extra positional arguments
        if p_idx < len(pos_tokens):
            return CliResult(current_cmd, ctx, 2, False, False, "Unexpected extra argument: " + pos_tokens[p_idx])

        # 4. Fill in option defaults and check required options
        oi: int = 0
        while oi < len(current_cmd.options):
            opt_d: Option = current_cmd.options[oi]
            if opt_d.is_flag:
                if opt_d.name not in ctx.flags:
                    ctx.set_flag(opt_d.name, False)
            else:
                if opt_d.name not in ctx.values:
                    if opt_d.required:
                        return CliResult(current_cmd, ctx, 2, False, False, "Missing required option: --" + opt_d.name)
                    if len(opt_d.default_val) > 0:
                        ctx.set_value(opt_d.name, opt_d.default_val)
            oi = oi + 1

        return CliResult(current_cmd, ctx, 0, False, False, "")

    def run(self: CliApp, argv: list[str] | None = None) -> int:
        args_to_parse: list[str] = []
        if argv is not None:
            args_to_parse = argv
        else:
            total: int = nox.os.arg_count()
            # Skip argv[0] (the program itself)
            idx: int = 1
            while idx < total:
                args_to_parse.append(nox.os.arg(idx))
                idx = idx + 1

        res: CliResult = self.parse(args_to_parse)

        if res.help_requested:
            help_text: str = res.command.format_help(self.console)
            self.console.print(help_text)
            return 0

        if res.version_requested:
            self.console.print(self.root.name + " " + self.version)
            return 0

        if not res.is_success():
            self.console.print_styled("Error: " + res.error_message, Style("red", "", True))
            self.console.print("Try '" + self.root.name + " --help' for help.")
            return res.exit_code

        return 0

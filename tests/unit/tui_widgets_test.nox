# tests/unit/tui_widgets_test.nox — Comprehensive unit tests for declarative TUI widgets.

import nox.test
import core
from core import Style
import layout
from layout import Rect
import tui
from tui import ScreenBuffer
import widgets
from widgets import Block, Paragraph, Gauge, Tabs, ListItem, ListWidget, TableWidget, HelpBar

# 1. Block Widget Tests
buf: ScreenBuffer = ScreenBuffer(30, 10)
blk: Block = Block("Status", "left", "rounded")

# Inner rect calculation
area: Rect = Rect(0, 0, 20, 8)
inner_area: Rect = blk.inner(area)
nox.test.assert_eq_int(inner_area.x, 1, "inner rect x inset by 1")
nox.test.assert_eq_int(inner_area.y, 1, "inner rect y inset by 1")
nox.test.assert_eq_int(inner_area.width, 18, "inner rect width reduced by 2")
nox.test.assert_eq_int(inner_area.height, 6, "inner rect height reduced by 2")

# Render rounded block
blk.render(area, buf)
nox.test.assert_eq_str(buf.get(0, 0).char, "╭", "top-left rounded corner")
nox.test.assert_eq_str(buf.get(19, 0).char, "╮", "top-right rounded corner")
nox.test.assert_eq_str(buf.get(0, 7).char, "╰", "bottom-left rounded corner")
nox.test.assert_eq_str(buf.get(19, 7).char, "╯", "bottom-right rounded corner")
nox.test.assert_eq_str(buf.get(0, 1).char, "│", "vertical border")

# Title check: " Status " at area.x + 2
nox.test.assert_eq_str(buf.get(2, 0).char, " ", "title padding")
nox.test.assert_eq_str(buf.get(3, 0).char, "S", "title char S")
nox.test.assert_eq_str(buf.get(4, 0).char, "t", "title char t")

# Title clipping check: long title must NOT overwrite top-right corner
buf.clear()
blk_long: Block = Block("A Very Very Long Long Title Indeed", "left", "rounded")
blk_long.render(Rect(0, 0, 12, 4), buf)
nox.test.assert_eq_str(buf.get(11, 0).char, "╮", "top-right corner preserved despite oversized title")
nox.test.assert_eq_str(buf.get(0, 0).char, "╭", "top-left corner preserved")

# Square border type
buf.clear()
blk_sq: Block = Block("", "left", "square")
blk_sq.render(Rect(0, 0, 10, 5), buf)
nox.test.assert_eq_str(buf.get(0, 0).char, "┌", "top-left square corner")
nox.test.assert_eq_str(buf.get(9, 0).char, "┐", "top-right square corner")
nox.test.assert_eq_str(buf.get(0, 4).char, "└", "bottom-left square corner")
nox.test.assert_eq_str(buf.get(9, 4).char, "┘", "bottom-right square corner")

# Double border type
buf.clear()
blk_db: Block = Block("", "left", "double")
blk_db.render(Rect(0, 0, 10, 5), buf)
nox.test.assert_eq_str(buf.get(0, 0).char, "╔", "top-left double corner")
nox.test.assert_eq_str(buf.get(9, 0).char, "╗", "top-right double corner")
nox.test.assert_eq_str(buf.get(1, 0).char, "═", "horizontal double border")
nox.test.assert_eq_str(buf.get(0, 1).char, "║", "vertical double border")

# ASCII border type
buf.clear()
blk_asc: Block = Block("", "left", "ascii")
blk_asc.render(Rect(0, 0, 10, 5), buf)
nox.test.assert_eq_str(buf.get(0, 0).char, "+", "top-left ascii corner")
nox.test.assert_eq_str(buf.get(1, 0).char, "-", "horizontal ascii border")
nox.test.assert_eq_str(buf.get(0, 1).char, "|", "vertical ascii border")

# 2. Paragraph Widget Tests
buf.clear()
p1: Paragraph = Paragraph("Hello World", None, True, 0, "left")
p1.render(Rect(2, 2, 15, 3), buf)
nox.test.assert_eq_str(buf.get(2, 2).char, "H", "paragraph starts at x=2, y=2")
nox.test.assert_eq_str(buf.get(6, 2).char, "o", "paragraph text char")

# Paragraph multi-line wrapping
buf.clear()
p_wrap: Paragraph = Paragraph("The quick brown fox jumps over the lazy dog", None, True, 0, "left")
p_wrap.render(Rect(0, 0, 16, 4), buf)
nox.test.assert_eq_str(buf.get(0, 0).char, "T", "first line starts with T")
# 2nd line must exist
nox.test.assert_true(buf.get(0, 1).char != " ", "second line contains wrapped text")

# Paragraph right-alignment clipping check
buf.clear()
p_right: Paragraph = Paragraph("LongRightAlignedText", None, False, 0, "right")
p_right.render(Rect(5, 0, 10, 2), buf)
# Characters must NOT spill past col 14 (5 + 10 - 1)
nox.test.assert_eq_str(buf.get(15, 0).char, " ", "paragraph text clipped at rect boundary")

# 3. Gauge Widget Tests
buf.clear()
g: Gauge = Gauge(50, "50%", None, None, None, "█", "─")
g.render(Rect(0, 0, 20, 1), buf)
# First 10 cells (0..9) should be '█', 10..19 should be '─' or label
# Cell 0 must be filled
nox.test.assert_eq_str(buf.get(0, 0).char, "█", "first gauge cell filled")
nox.test.assert_eq_str(buf.get(1, 0).char, "█", "second gauge cell filled")
# Cell 19 must be track or label
nox.test.assert_true(buf.get(19, 0).char == "─" or buf.get(19, 0).char == "%", "end cell is track or label")

# Clamping
g_neg: Gauge = Gauge(-20)
nox.test.assert_eq_int(g_neg.percentage, 0, "negative percentage clamped to 0")
g_over: Gauge = Gauge(150)
nox.test.assert_eq_int(g_over.percentage, 100, "over-100 percentage clamped to 100")

# 4. Tabs Widget Tests
buf.clear()
tabs: Tabs = Tabs(["Overview", "Logs", "Settings"], 1, "│")
tabs.render(Rect(0, 0, 30, 1), buf)
# Tab 0 is unselected: "Overview"
nox.test.assert_eq_str(buf.get(0, 0).char, "O", "tab 0 starts with O")
# Tab 1 is selected: "[Logs]"
# Check somewhere after Tab 0 contains '['
found_bracket: bool = False
idx: int = 0
while idx < 25:
    if buf.get(idx, 0).char == "[":
        found_bracket = True
    idx = idx + 1
nox.test.assert_true(found_bracket, "selected tab enclosed in brackets")

# 5. ListWidget Tests
buf.clear()
lst: ListWidget = ListWidget(-1, "► ")
lst.add_item("Item 1")
lst.add_item("Item 2")
lst.add_item("Item 3")
nox.test.assert_eq_int(len(lst.items), 3, "three items in list")

# Selection navigation
lst.select_next()
nox.test.assert_eq_int(lst.selected_index, 0, "select next from -1 moves to 0")
lst.select_next()
nox.test.assert_eq_int(lst.selected_index, 1, "select next moves to 1")
lst.select_prev()
nox.test.assert_eq_int(lst.selected_index, 0, "select prev moves to 0")
lst.select_prev()
nox.test.assert_eq_int(lst.selected_index, 2, "select prev wraps around to last item")

# Render list
buf.clear()
lst.select(0)
lst.render(Rect(0, 0, 20, 5), buf)
# Row 0 has highlight symbol '► '
nox.test.assert_eq_str(buf.get(0, 0).char, "►", "first row has selection pointer")

# 6. TableWidget Tests
buf.clear()
tbl: TableWidget = TableWidget(["ID", "Name", "Role"], [5, 10, 10])
tbl.add_row(["1", "Alice", "Admin"])
tbl.add_row(["2", "Bob", "User"])
tbl.render(Rect(0, 0, 30, 6), buf)

# Header row at y=0
nox.test.assert_eq_str(buf.get(0, 0).char, "I", "header starts with I")
nox.test.assert_eq_str(buf.get(1, 0).char, "D", "header second char D")

# Separator row at y=1
nox.test.assert_eq_str(buf.get(0, 1).char, "─", "separator horizontal line")

# First data row at y=2
nox.test.assert_eq_str(buf.get(0, 2).char, "1", "data row 1 ID is 1")
# Second data row at y=3
nox.test.assert_eq_str(buf.get(0, 3).char, "2", "data row 2 ID is 2")

# 7. HelpBar Widget Tests
buf.clear()
help_bar: HelpBar = HelpBar(None, None, " | ")
help_bar.add("q", "Quit")
help_bar.add("r", "Refresh")
help_bar.render(Rect(0, 0, 30, 1), buf)

nox.test.assert_eq_str(buf.get(0, 0).char, "q", "first keybinding is q")
nox.test.assert_eq_str(buf.get(2, 0).char, "Q", "first desc starts with Q")

# 8. ScreenBuffer to_text() Test
buf_mini: ScreenBuffer = ScreenBuffer(5, 2)
buf_mini.write_string(0, 0, "AB")
buf_mini.write_string(0, 1, "CD")
txt: str = buf_mini.to_text()
nox.test.assert_eq_str(txt, "AB   \nCD   ", "buffer to_text outputs rows separated by newline")

# 9. ScreenBuffer Global Clipping Tests
buf_clip: ScreenBuffer = ScreenBuffer(10, 5)
buf_clip.set_clip(Rect(2, 1, 4, 3))
# Try to write outside clip bounds
buf_clip.set(0, 0, "X")
nox.test.assert_eq_str(buf_clip.get(0, 0).char, " ", "cell outside clip_rect remains untouched")

# Write inside clip bounds
buf_clip.set(3, 2, "Y")
nox.test.assert_eq_str(buf_clip.get(3, 2).char, "Y", "cell inside clip_rect is written")

# Write string starting outside clip bound (0..7, clipped to 2..5)
buf_clip.write_string(0, 2, "ABCDEFGH")
nox.test.assert_eq_str(buf_clip.get(1, 2).char, " ", "prefix before clip_rect left bound untouched")
nox.test.assert_eq_str(buf_clip.get(2, 2).char, "C", "character offset correctly aligns at left clip bound")
nox.test.assert_eq_str(buf_clip.get(3, 2).char, "D", "character D written at column 3")
nox.test.assert_eq_str(buf_clip.get(4, 2).char, "E", "character E written at column 4")
nox.test.assert_eq_str(buf_clip.get(5, 2).char, "F", "character F written at column 5")
nox.test.assert_eq_str(buf_clip.get(6, 2).char, " ", "suffix after clip_rect right bound untouched")

# Fill rect clipped
buf_clip.fill_rect(0, 0, 10, 5, "#")
nox.test.assert_eq_str(buf_clip.get(0, 0).char, " ", "fill_rect clipped at top-left")
nox.test.assert_eq_str(buf_clip.get(2, 1).char, "#", "fill_rect fills inside clip_rect")

buf_clip.set_clip(None)

# 10. Left-Clipping Text Offset Exact Case (GPT 5.6 Test)
buf_clip2: ScreenBuffer = ScreenBuffer(15, 3)
buf_clip2.set_clip(Rect(5, 1, 5, 1))
buf_clip2.write_string(0, 1, "ABCDEFGHIJ")
nox.test.assert_eq_str(buf_clip2.get(4, 1).char, " ", "column 4 untouched")
nox.test.assert_eq_str(buf_clip2.get(5, 1).char, "F", "column 5 is F")
nox.test.assert_eq_str(buf_clip2.get(6, 1).char, "G", "column 6 is G")
nox.test.assert_eq_str(buf_clip2.get(7, 1).char, "H", "column 7 is H")
nox.test.assert_eq_str(buf_clip2.get(8, 1).char, "I", "column 8 is I")
nox.test.assert_eq_str(buf_clip2.get(9, 1).char, "J", "column 9 is J")
nox.test.assert_eq_str(buf_clip2.get(10, 1).char, " ", "column 10 untouched")

# 11. Wide Character Clipping Integrity Tests
buf_wide: ScreenBuffer = ScreenBuffer(10, 3)
buf_wide.set_clip(Rect(0, 0, 5, 3))
buf_wide.set(4, 0, "界")
nox.test.assert_eq_str(buf_wide.get(4, 0).char, " ", "wide char right edge cannot leak continuation outside clip")
nox.test.assert_eq_str(buf_wide.get(5, 0).char, " ", "column 5 outside clip rect remains untouched")

buf_wide2: ScreenBuffer = ScreenBuffer(10, 3)
buf_wide2.set_clip(Rect(2, 0, 5, 3))
buf_wide2.write_string(0, 0, "A界B")
nox.test.assert_eq_str(buf_wide2.get(2, 0).char, " ", "straddling wide char left half replaced with space at clip edge")
nox.test.assert_eq_str(buf_wide2.get(3, 0).char, "B", "character inside clip window correctly placed at column 3")

# 12. Clip Stack Tests (push_clip, pop_clip)
buf_stack: ScreenBuffer = ScreenBuffer(20, 10)
buf_stack.push_clip(Rect(2, 2, 10, 6))
c1: Rect | None = buf_stack.get_clip()
if c1 != None:
    nox.test.assert_eq_int(c1.x, 2, "initial clip pushed x=2")
buf_stack.push_clip(Rect(5, 3, 10, 6))
c2: Rect | None = buf_stack.get_clip()
if c2 != None:
    nox.test.assert_eq_int(c2.x, 5, "nested clip intersected x is 5")
    nox.test.assert_eq_int(c2.width, 7, "nested clip intersected width is 7")
buf_stack.pop_clip()
c3: Rect | None = buf_stack.get_clip()
if c3 != None:
    nox.test.assert_eq_int(c3.x, 2, "popped clip restored previous clip x=2")
buf_stack.pop_clip()
nox.test.assert_true(buf_stack.get_clip() == None, "popping all clips clears clip_rect")

# 13. External Wide Character Boundary Preservation & Invariant Validation (GPT 5.6 Scenarios)
# Scenario A: Left-neighbor outside clip
buf_ext: ScreenBuffer = ScreenBuffer(10, 2)
buf_ext.set(4, 0, "界")
nox.test.assert_eq_str(buf_ext.get(4, 0).char, "界", "cell 4 is wide char")
nox.test.assert_eq_int(buf_ext.get(5, 0).width, 0, "cell 5 is continuation")
nox.test.assert_true(buf_ext.validate_invariants(), "initial invariants valid")

# Activate clip rect covering columns 5..9 (cell 4 is strictly outside!)
buf_ext.set_clip(Rect(5, 0, 5, 1))
# Attempt to write inside clip rect at cell 5:
# Must be atomically rejected because mutating cell 5 would orphan cell 4 outside clip!
buf_ext.set(5, 0, "A")
nox.test.assert_eq_str(buf_ext.get(4, 0).char, "界", "wide char at cell 4 outside clip rect is preserved")
nox.test.assert_eq_int(buf_ext.get(5, 0).width, 0, "cell 5 remains continuation to avoid orphaning cell 4")
nox.test.assert_true(buf_ext.validate_invariants(), "invariants hold after rejected write")

# Scenario B: Right-neighbor outside clip
buf_ext_r: ScreenBuffer = ScreenBuffer(10, 2)
buf_ext_r.set(4, 0, "界")
# Activate clip rect covering columns 0..4 (cell 5 is strictly outside!)
buf_ext_r.set_clip(Rect(0, 0, 5, 1))
# Attempt to overwrite cell 4 with narrow char:
# Must be atomically rejected because clearing continuation at cell 5 would write outside clip!
buf_ext_r.set(4, 0, "B")
nox.test.assert_eq_str(buf_ext_r.get(4, 0).char, "界", "cell 4 remains wide char")
nox.test.assert_eq_int(buf_ext_r.get(5, 0).width, 0, "cell 5 continuation remains preserved outside clip")
nox.test.assert_true(buf_ext_r.validate_invariants(), "invariants hold after rejected right-boundary write")

# Scenario C: Wide character overwriting wide character whose continuation is outside clip
buf_ext_c: ScreenBuffer = ScreenBuffer(10, 2)
buf_ext_c.set(6, 0, "界") # columns 6 and 7
buf_ext_c.set_clip(Rect(5, 0, 2, 1)) # columns 5 and 6 (column 7 is outside clip)
# Attempt to write wide char at column 5 (occupies 5 and 6):
# Overwriting column 6 would orphan continuation at column 7!
buf_ext_c.set(5, 0, "世")
nox.test.assert_eq_str(buf_ext_c.get(6, 0).char, "界", "column 6 remains wide char")
nox.test.assert_eq_int(buf_ext_c.get(7, 0).width, 0, "column 7 remains continuation")
nox.test.assert_true(buf_ext_c.validate_invariants(), "invariants hold without orphaned continuation")

# Scenario D: Valid wide character completely within clip
buf_valid: ScreenBuffer = ScreenBuffer(10, 2)
buf_valid.set_clip(Rect(1, 0, 6, 1))
buf_valid.set(2, 0, "世")
nox.test.assert_eq_str(buf_valid.get(2, 0).char, "世", "wide char written inside clip")
nox.test.assert_eq_int(buf_valid.get(3, 0).width, 0, "continuation cell written inside clip")
nox.test.assert_true(buf_valid.validate_invariants(), "invariants hold for valid write")

print("tui_widgets_test passed")

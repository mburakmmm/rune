# 1. ScreenBuffer invariant fuzzing (clipping + wide Unicode + resize + fill_rect)
def prop_screen_buffer_invariants(r: Rng) -> bool:
    w: int = r.int_range(4, 24)
    h: int = r.int_range(2, 10)
    buf: ScreenBuffer = ScreenBuffer(w, h)
    samples: list[str] = ["A", "B", "界", "🙂", " ", "é", "Z"]

    steps: int = r.int_range(5, 30)
    s_idx: int = 0
    while s_idx < steps:
        op: int = r.int_range(0, 4)
        if op == 0:
            # Push nested clip
            cx: int = r.int_range(0, w - 1)
            cy: int = r.int_range(0, h - 1)
            cw: int = r.int_range(0, w)
            ch: int = r.int_range(0, h)
            buf.push_clip(Rect(cx, cy, cw, ch))
        elif op == 1:
            buf.pop_clip()
        elif op == 2:
            px: int = r.int_range(-2, w + 1)
            py: int = r.int_range(-1, h)
            token: str = r.choice_str(samples)
            buf.write_string(px, py, token + token)
        elif op == 3:
            fx: int = r.int_range(0, w - 1)
            fy: int = r.int_range(0, h - 1)
            fw: int = r.int_range(1, 5)
            fh: int = r.int_range(1, 3)
            buf.fill_rect(fx, fy, fw, fh, " ")
        else:
            nw: int = r.int_range(4, 24)
            nh: int = r.int_range(2, 10)
            buf.resize(nw, nh)
            w = nw
            h = nh
        if not buf.validate_invariants():
            return False
        s_idx = s_idx + 1

    buf.set_clip(None)
    return buf.validate_invariants()

nox.property.check("screen_buffer_invariants", prop_screen_buffer_invariants, 60, 202601, 40)

# 2. KeyDecoder fragmented UTF-8 & CSI fuzzing
def prop_key_decoder_fragmented(r: Rng) -> bool:
    tokens: list[str] = ["a", "b", "é", "界", "🙂", chr(27) + "[A", chr(27) + "[1;5B", chr(3), "\n"]
    full: str = ""
    parts_count: int = r.int_range(1, 10)
    k: int = 0
    while k < parts_count:
        full = full + r.choice_str(tokens)
        k = k + 1

    whole_dec: KeyDecoder = KeyDecoder()
    expected: list[KeyEvent] = whole_dec.decode(full)

    # Split arbitrarily by bytes and verify reassembly matches whole decoding
    total_b: int = nox.strings.byte_len(full)
    frag_dec: KeyDecoder = KeyDecoder()
    got: list[KeyEvent] = []
    pos: int = 0
    while pos < total_b:
        step: int = r.int_range(1, 3)
        end_p: int = pos + step
        if end_p > total_b:
            end_p = total_b
        chunk_bytes: list[int] = []
        bi: int = pos
        while bi < end_p:
            chunk_bytes.append(nox.strings.byte_at(full, bi))
            bi = bi + 1
        chunk: str = nox.bytes.str_from_list(chunk_bytes)
        ev_part: list[KeyEvent] = frag_dec.feed(chunk)
        ei: int = 0
        while ei < len(ev_part):
            got.append(ev_part[ei])
            ei = ei + 1
        if len(frag_dec.buffer) > 32 or len(frag_dec.utf8_pending) > 4:
            return False
        pos = end_p

    flushed: list[KeyEvent] = frag_dec.flush()
    fi: int = 0
    while fi < len(flushed):
        got.append(flushed[fi])
        fi = fi + 1

    if len(got) != len(expected):
        return False
    idx: int = 0
    while idx < len(got):
        if got[idx].to_str() != expected[idx].to_str():
            return False
        idx = idx + 1
    return True

nox.property.check("key_decoder_fragmented_utf8", prop_key_decoder_fragmented, 60, 202602, 30)

# 3. sanitize_ansi never leaks ESC, standalone CR, or C1 control bytes
def prop_sanitize_ansi_safety(r: Rng) -> bool:
    frags: list[str] = ["ok", " ", "\n", "\r", esc_code() + "[31m", esc_code() + "]8;;https://evil" + chr(7), nox.strings.char_from_byte(155) + "2J", chr(8), "hello"]
    raw: str = ""
    n: int = r.int_range(1, 15)
    i: int = 0
    while i < n:
        raw = raw + r.choice_str(frags)
        i = i + 1

    cleaned: str = sanitize_ansi(raw)
    if nox.strings.contains(cleaned, esc_code()):
        return False
    if nox.strings.contains(cleaned, "\r"):
        return False
    if nox.strings.contains(cleaned, nox.strings.char_from_byte(155)):
        return False
    return True

nox.property.check("sanitize_ansi_safety", prop_sanitize_ansi_safety, 60, 202603, 30)

# 4. wrap_text width bound invariant
def prop_wrap_text_bounds(r: Rng) -> bool:
    words: list[str] = ["rune", "nox", "terminal", "界", "abcdef", "hi"]
    txt: str = ""
    cnt: int = r.int_range(1, 12)
    i: int = 0
    while i < cnt:
        if i > 0:
            txt = txt + " "
        txt = txt + r.choice_str(words)
        i = i + 1

    max_w: int = r.int_range(4, 20)
    lines: list[str] = wrap_text(txt, max_w)
    li: int = 0
    while li < len(lines):
        if cell_width(lines[li]) > max_w:
            return False
        li = li + 1
    return True

nox.property.check("wrap_text_bounds", prop_wrap_text_bounds, 50, 202604, 30)

# 5. CliApp parser never crashes unexpectedly on arbitrary tokens
def prop_cli_parse_resilient(r: Rng) -> bool:
    cmd: Command = Command("fuzztool", "Fuzz target")
    cmd.add_argument("input", TYPE_STR, False, "default")
    cmd.add_option("count", "c", TYPE_INT, False, False, "1", "Count")
    cmd.add_option("verbose", "v", TYPE_BOOL, True, False, "false", "Verbose")
    opts_ci: ConsoleOptions = ConsoleOptions(False, False, 80, 24, False, True)
    con: Console = Console(opts_ci)
    app: CliApp = CliApp(cmd, "1.5.0", con)

    tokens_pool: list[str] = ["file.txt", "--count", "42", "--count=-5", "-v", "--bad", "--", "-10", "abc"]
    args: list[str] = []
    n: int = r.int_range(0, 6)
    i: int = 0
    while i < n:
        args.append(r.choice_str(tokens_pool))
        i = i + 1

    try:
        res: CliResult = app.parse(args)
        return res.exit_code >= 0
    except CliError:
        return True
    return False

nox.property.check("cli_parse_resilient", prop_cli_parse_resilient, 50, 202605, 20)

print("property_fuzz_test passed")

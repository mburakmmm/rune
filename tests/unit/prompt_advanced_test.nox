# tests/unit/prompt_advanced_test.nox — Tests for prompt_int and select_multiple non-blocking behaviors.

import nox.test
import core
from core import Console, ConsoleOptions
import prompt
from prompt import prompt_int, select_multiple, NonInteractiveError

opts_ci: ConsoleOptions = ConsoleOptions(False, True, 80, 24, False, True)
test_con: Console = Console(opts_ci)

# 1. prompt_int in non-interactive mode with default
res_int_def: int = prompt_int("Enter port", 8080, None, None, 3, test_con)
nox.test.assert_eq_int(res_int_def, 8080, "prompt_int must return default_val in CI")

# prompt_int without default must raise NonInteractiveError
int_err1: bool = False
try:
    prompt_int("Enter count", None, 1, 100, 3, test_con)
except NonInteractiveError:
    int_err1 = True
nox.test.assert_true(int_err1, "prompt_int without default in CI must raise NonInteractiveError")

int_err2: bool = False
try:
    prompt_int("Enter number", None, None, None, 3, test_con)
except NonInteractiveError:
    int_err2 = True
nox.test.assert_true(int_err2, "prompt_int without default must raise NonInteractiveError")

# 2. select_multiple in non-interactive mode
frameworks: list[str] = ["Rune", "Nova", "Noxen", "Feather"]

# With explicit default choices
defaults: list[str] = ["Rune", "Nova"]
res_multi_def: list[str] = select_multiple("Select frameworks", frameworks, defaults, test_con)
nox.test.assert_eq_int(len(res_multi_def), 2, "select_multiple returns default_choices in CI")
nox.test.assert_eq_str(res_multi_def[0], "Rune", "First default matches")
nox.test.assert_eq_str(res_multi_def[1], "Nova", "Second default matches")

# Without default choices: must raise NonInteractiveError
multi_err: bool = False
try:
    select_multiple("Select frameworks", frameworks, None, test_con)
except NonInteractiveError:
    multi_err = True
nox.test.assert_true(multi_err, "select_multiple without default must raise NonInteractiveError in CI")

# Empty choices list
empty_in: list[str] = []
res_empty: list[str] = select_multiple("Empty", empty_in, None, test_con)
nox.test.assert_eq_int(len(res_empty), 0, "Empty choices returns empty list")

print("prompt_advanced_test passed")

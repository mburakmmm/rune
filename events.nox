# events.nox — ANSI key sequence decoder, terminal events, and event structures for Rune TUI.

import nox.strings
import nox.bytes

enum EventKind:
    Key
    Tick
    Resize

EVENT_KEY: EventKind = EventKind.Key
EVENT_TICK: EventKind = EventKind.Tick
EVENT_RESIZE: EventKind = EventKind.Resize

class KeyEvent:
    key: str
    ctrl: bool
    alt: bool
    shift: bool

    def __init__(self: KeyEvent, key: str, ctrl: bool = False, alt: bool = False, shift: bool = False) -> None:
        self.key = key
        self.ctrl = ctrl
        self.alt = alt
        self.shift = shift

    def to_str(self: KeyEvent) -> str:

        res: str = ""
        if self.ctrl:
            res = res + "ctrl+"
        if self.alt:
            res = res + "alt+"
        if self.shift:
            res = res + "shift+"
        res = res + self.key
        return res

    def matches(self: KeyEvent, pattern: str) -> bool:

        pat: str = nox.strings.lower(pattern)
        if self.to_str() == pat:
            return True
        if self.key == pat and not self.ctrl and not self.alt:
            return True
        return False

class TickEvent:
    delta_ms: int

    def __init__(self: TickEvent, delta_ms: int = 0) -> None:
        self.delta_ms = delta_ms

class ResizeEvent:
    width: int
    height: int

    def __init__(self: ResizeEvent, width: int, height: int) -> None:
        self.width = width
        self.height = height

class Event:
    type: EventKind
    key: str
    ctrl: bool
    alt: bool
    shift: bool
    delta_ms: int
    width: int
    height: int

    def __init__(self: Event, type: EventKind, key: str = "", ctrl: bool = False, alt: bool = False, shift: bool = False, delta_ms: int = 0, width: int = 0, height: int = 0) -> None:
        self.type = type
        self.key = key
        self.ctrl = ctrl
        self.alt = alt
        self.shift = shift
        self.delta_ms = delta_ms
        self.width = width
        self.height = height

    def to_key_event(self: Event) -> KeyEvent:

        return KeyEvent(self.key, self.ctrl, self.alt, self.shift)

    def is_key(self: Event, expected: str = "") -> bool:

        match self.type:
            case EventKind.Key:
                if len(expected) == 0:
                    return True
                return self.to_key_event().matches(expected)
            case EventKind.Tick:
                return False
            case EventKind.Resize:
                return False

    def is_ctrl(self: Event, expected: str = "") -> bool:

        match self.type:
            case EventKind.Key:
                if not self.ctrl:
                    return False
                if len(expected) == 0:
                    return True
                return self.key == expected
            case EventKind.Tick:
                return False
            case EventKind.Resize:
                return False

    def is_tick(self: Event) -> bool:

        return self.type == EventKind.Tick

    def is_resize(self: Event) -> bool:

        return self.type == EventKind.Resize

    def key_str(self: Event) -> str:

        match self.type:
            case EventKind.Key:
                return self.to_key_event().to_str()
            case EventKind.Tick:
                return ""
            case EventKind.Resize:
                return ""

def make_key_event(key: str, ctrl: bool = False, alt: bool = False, shift: bool = False) -> Event:
    return Event(EventKind.Key, key, ctrl, alt, shift, 0, 0, 0)

def make_tick_event(delta_ms: int) -> Event:
    return Event(EventKind.Tick, "", False, False, False, delta_ms, 0, 0)

def make_resize_event(width: int, height: int) -> Event:
    return Event(EventKind.Resize, "", False, False, False, 0, width, height)

def _utf8_seq_len(lead: int) -> int:
    if lead < 128:
        return 1
    if lead >= 194 and lead <= 223:
        return 2
    if lead >= 224 and lead <= 239:
        return 3
    if lead >= 240 and lead <= 244:
        return 4
    return -1

class KeyDecoder:
    buffer: str
    utf8_pending: list[int]

    def __init__(self: KeyDecoder) -> None:
        self.buffer = ""
        self.utf8_pending = []

    def clear(self: KeyDecoder) -> None:

        self.buffer = ""
        self.utf8_pending = []

    def _consume_utf8_bytes(self: KeyDecoder, chunk: str) -> str:

        c_bytes: int = nox.strings.byte_len(chunk)
        if c_bytes == 0 and len(self.utf8_pending) == 0:
            return ""

        all_bytes: list[int] = []
        p_idx: int = 0
        while p_idx < len(self.utf8_pending):
            all_bytes.append(self.utf8_pending[p_idx])
            p_idx = p_idx + 1
        self.utf8_pending = []

        idx: int = 0
        while idx < c_bytes:
            all_bytes.append(nox.strings.byte_at(chunk, idx))
            idx = idx + 1

        total: int = len(all_bytes)
        if total == 0:
            return ""

        ready: list[int] = []
        pos: int = 0
        while pos < total:
            b: int = all_bytes[pos]
            if b < 128:
                ready.append(b)
                pos = pos + 1
                continue

            need: int = _utf8_seq_len(b)
            if need < 0:
                # Skip stray continuation or invalid UTF-8 lead byte
                pos = pos + 1
                continue

            if pos + need > total:
                # Save incomplete trailing multi-byte sequence for next read_raw() chunk
                rem: int = pos
                while rem < total:
                    self.utf8_pending.append(all_bytes[rem])
                    rem = rem + 1
                break

            valid: bool = True
            k: int = 1
            while k < need:
                cb: int = all_bytes[pos + k]
                if cb < 128 or cb > 191:
                    valid = False
                    break
                k = k + 1

            # Reject overlong E0/F0/surrogate ED encodings safely
            if valid and need == 3:
                b1: int = all_bytes[pos + 1]
                if b == 224 and b1 < 160 or b == 237 and b1 >= 160:
                    valid = False
            elif valid and need == 4:
                b1_4: int = all_bytes[pos + 1]
                if b == 240 and b1_4 < 144 or b == 244 and b1_4 > 143:
                    valid = False

            if not valid:
                pos = pos + 1
                continue

            k2: int = 0
            while k2 < need:
                ready.append(all_bytes[pos + k2])
                k2 = k2 + 1
            pos = pos + need

        if len(ready) == 0:
            return ""
        return nox.bytes.str_from_list(ready)

    def feed(self: KeyDecoder, chunk: str) -> list[KeyEvent]:

        valid_chunk: str = self._consume_utf8_bytes(chunk)
        raw: str = self.buffer + valid_chunk
        self.buffer = ""
        decoded: list[KeyEvent] = []
        n: int = len(raw)
        i: int = 0
        while i < n:
            ch: str = raw[i]
            b: int = ord(ch)

            # 1. Escape Sequences
            if b == 27:
                # If ESC is at the very end of chunk, retain in buffer in case it's part of a sequence
                if i + 1 >= n:
                    self.buffer = raw[i:]
                    break
                next_ch: str = raw[i + 1]

                # CSI: \x1b[
                if next_ch == "[":
                    # Look ahead for terminator character (ASCII 0x40 to 0x7E)
                    j: int = i + 2
                    while j < n and not (ord(raw[j]) >= 64 and ord(raw[j]) <= 126):
                        j = j + 1
                    if j < n:
                        term: str = raw[j]
                        param_str: str = raw[i + 2:j]
                        ctrl: bool = False
                        alt: bool = False
                        shift: bool = False

                        if nox.strings.contains(param_str, ";"):
                            parts: list[str] = nox.strings.split(param_str, ";")
                            if len(parts) >= 2:
                                mod: str = parts[1]
                                if mod == "2":
                                    shift = True
                                elif mod == "3":
                                    alt = True
                                elif mod == "5":
                                    ctrl = True
                                elif mod == "6":
                                    ctrl = True
                                    shift = True

                        if term == "A":
                            decoded.append(KeyEvent("up", ctrl, alt, shift))
                        elif term == "B":
                            decoded.append(KeyEvent("down", ctrl, alt, shift))
                        elif term == "C":
                            decoded.append(KeyEvent("right", ctrl, alt, shift))
                        elif term == "D":
                            decoded.append(KeyEvent("left", ctrl, alt, shift))
                        elif term == "H":
                            decoded.append(KeyEvent("home", ctrl, alt, shift))
                        elif term == "F":
                            decoded.append(KeyEvent("end", ctrl, alt, shift))
                        elif term == "Z":
                            decoded.append(KeyEvent("backtab", False, False, True))
                        elif term == "~":
                            p: str = param_str
                            if nox.strings.contains(p, ";"):
                                p = nox.strings.split(p, ";")[0]
                            if p == "1":
                                decoded.append(KeyEvent("home"))
                            elif p == "2":
                                decoded.append(KeyEvent("insert"))
                            elif p == "3":
                                decoded.append(KeyEvent("delete"))
                            elif p == "4":
                                decoded.append(KeyEvent("end"))
                            elif p == "5":
                                decoded.append(KeyEvent("pageup"))
                            elif p == "6":
                                decoded.append(KeyEvent("pagedown"))
                            elif p == "11":
                                decoded.append(KeyEvent("f1"))
                            elif p == "12":
                                decoded.append(KeyEvent("f2"))
                            elif p == "13":
                                decoded.append(KeyEvent("f3"))
                            elif p == "14":
                                decoded.append(KeyEvent("f4"))
                            elif p == "15":
                                decoded.append(KeyEvent("f5"))
                            elif p == "17":
                                decoded.append(KeyEvent("f6"))
                            elif p == "18":
                                decoded.append(KeyEvent("f7"))
                            elif p == "19":
                                decoded.append(KeyEvent("f8"))
                            elif p == "20":
                                decoded.append(KeyEvent("f9"))
                            elif p == "21":
                                decoded.append(KeyEvent("f10"))
                            elif p == "23":
                                decoded.append(KeyEvent("f11"))
                            elif p == "24":
                                decoded.append(KeyEvent("f12"))
                        i = j + 1
                        continue
                    else:
                        # Incomplete CSI sequence, retain in buffer for next feed()
                        if n - i > 32:
                            # runaway malformed CSI sequence; discard ESC to prevent unbounded buffering
                            i = i + 1
                            continue
                        self.buffer = raw[i:]
                        break
                elif next_ch == "O":

                    # SS3: \x1bO
                    if i + 2 < n:
                        fn: str = raw[i + 2]
                        if fn == "P":
                            decoded.append(KeyEvent("f1"))
                        elif fn == "Q":
                            decoded.append(KeyEvent("f2"))
                        elif fn == "R":
                            decoded.append(KeyEvent("f3"))
                        elif fn == "S":
                            decoded.append(KeyEvent("f4"))
                        i = i + 3
                        continue
                    else:
                        # Incomplete SS3 sequence, retain in buffer
                        self.buffer = raw[i:]
                        break
                else:

                    # Alt + character: \x1b<char>
                    decoded.append(KeyEvent(next_ch, False, True, False))
                    i = i + 2
                    continue
            elif b == 0:

                # 2. Control Characters
                decoded.append(KeyEvent("space", True, False, False))
            elif b == 9:
                decoded.append(KeyEvent("tab"))
            elif b == 10 or b == 13:
                decoded.append(KeyEvent("enter"))
            elif b == 127 or b == 8:
                decoded.append(KeyEvent("backspace"))
            elif b >= 1 and b <= 26:
                ctrl_key: str = chr(96 + b)
                decoded.append(KeyEvent(ctrl_key, True, False, False))
            else:

                # 3. Standard Characters
                decoded.append(KeyEvent(ch, False, False, False))

            i = i + 1

        return decoded

    def decode(self: KeyDecoder, raw: str) -> list[KeyEvent]:

        res: list[KeyEvent] = self.feed(raw)
        if len(self.buffer) > 0:
            flushed: list[KeyEvent] = self.flush()
            idx: int = 0
            while idx < len(flushed):
                res.append(flushed[idx])
                idx = idx + 1
        return res

    def flush(self: KeyDecoder) -> list[KeyEvent]:

        self.utf8_pending = []
        res: list[KeyEvent] = []
        if len(self.buffer) > 0:
            b: str = self.buffer
            self.buffer = ""
            if b == chr(27) or b == "\x1b":
                res.append(KeyEvent("esc"))
            elif len(b) > 0 and ord(b[0]) == 27:
                # Escape followed by leftover chars that timed out
                res.append(KeyEvent("esc"))
                k: int = 1
                while k < len(b):
                    res.append(KeyEvent(b[k]))
                    k = k + 1
            else:
                k2: int = 0
                while k2 < len(b):
                    res.append(KeyEvent(b[k2]))
                    k2 = k2 + 1
        return res

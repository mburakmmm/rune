# progress.nox — Deterministic progress bars, multi-task live layout, ETA/speed calculations, and spinners.

import nox.strings
import nox.time
import nox.terminal
import core
from core import Style, Console, ConsoleOptions, cell_width, esc_code

__all__: list[str] = ["pad_num", "format_duration", "format_bytes", "Task", "ProgressBar", "Spinner", "Live", "track", "track_range"]

def _mono_ms() -> int:
    return nox.time.monotonic_ns() // 1000000

def pad_num(n: int, width: int = 2) -> str:
    s: str = str(n)
    return nox.strings.pad_left(s, width, "0")

def format_duration(seconds: int) -> str:
    if seconds < 0:
        return "--:--"
    m: int = seconds // 60
    s: int = seconds % 60
    if m >= 60:
        h: int = m // 60
        m = m % 60
        return pad_num(h, 2) + ":" + pad_num(m, 2) + ":" + pad_num(s, 2)
    return pad_num(m, 2) + ":" + pad_num(s, 2)

def format_bytes(b: int) -> str:
    if b < 1024:
        return str(b) + " B"
    if b < 1024 * 1024:
        kb: int = b // 1024
        return str(kb) + " KB"
    if b < 1024 * 1024 * 1024:
        mb: int = b // (1024 * 1024)
        return str(mb) + " MB"
    gb: int = b // (1024 * 1024 * 1024)
    return str(gb) + " GB"

class Task:
    name: str
    total: int
    completed: int
    finished: bool
    unit: str
    start_time_ms: int
    last_update_ms: int

    def __init__(self: Task, name: str, total: int = 100, unit: str = "items") -> None:
        self.name = name
        if total < 0:
            self.total = 0
        else:
            self.total = total
        self.completed = 0
        self.finished = False
        self.unit = unit
        now: int = _mono_ms()
        self.start_time_ms = now
        self.last_update_ms = now

    def advance(self: Task, step: int = 1) -> None:

        self.completed = self.completed + step
        if self.completed < 0:
            self.completed = 0
        self.last_update_ms = _mono_ms()
        if self.total > 0 and self.completed >= self.total:
            self.completed = self.total
            self.finished = True
        else:
            self.finished = False

    def update(self: Task, completed: int) -> None:

        if completed < 0:
            self.completed = 0
        else:
            self.completed = completed
        self.last_update_ms = _mono_ms()
        if self.total > 0 and self.completed >= self.total:
            self.completed = self.total
            self.finished = True
        else:
            self.finished = False

    def percentage(self: Task) -> int:

        if self.total <= 0:
            return 0
        pct: int = self.completed * 100 // self.total
        if pct < 0:
            return 0
        if pct > 100:
            return 100
        return pct

    def is_finished(self: Task) -> bool:

        return self.finished

    @property
    def done(self: Task) -> bool:

        return self.finished

    @property
    def ratio(self: Task) -> float:

        if self.total <= 0:
            return 0.0
        r: float = float(self.completed) / float(self.total)
        if r < 0.0:
            return 0.0
        if r > 1.0:
            return 1.0
        return r

    def elapsed_ms(self: Task) -> int:

        return _mono_ms() - self.start_time_ms

    def elapsed_seconds(self: Task) -> int:

        return self.elapsed_ms() // 1000

    def speed(self: Task) -> float:

        el_ms: int = self.elapsed_ms()
        if el_ms <= 0:
            return 0.0
        return float(self.completed) * 1000.0 / float(el_ms)

    def eta_seconds(self: Task) -> int:

        if self.finished or self.completed >= self.total:
            return 0
        rem: int = self.total - self.completed
        if rem <= 0:
            return 0
        spd: float = self.speed()
        if spd <= 0.001:
            return -1
        return int(float(rem) / spd)

    def format_eta(self: Task) -> str:

        s: int = self.eta_seconds()
        if s < 0:
            return "--:--"
        return format_duration(s)

class ProgressBar:
    tasks: list[Task]
    width: int
    bar_char: str
    empty_char: str
    min_interval_ms: int
    last_render_ms: int

    def __init__(self: ProgressBar, width: int = 20, bar_char: str = "█", empty_char: str = "─", min_interval_ms: int = 50) -> None:
        self.tasks = []
        self.width = width
        self.bar_char = bar_char
        self.empty_char = empty_char
        self.min_interval_ms = min_interval_ms
        self.last_render_ms = _mono_ms() - min_interval_ms

    def add_task(self: ProgressBar, name: str, total: int = 100, unit: str = "items") -> Task:

        t: Task = Task(name, total, unit)
        self.tasks.append(t)
        return t

    def should_render(self: ProgressBar) -> bool:

        now: int = _mono_ms()
        if now - self.last_render_ms >= self.min_interval_ms:
            self.last_render_ms = now
            return True
        return False

    def render_task(self: ProgressBar, task: Task, options: ConsoleOptions, show_eta: bool = True) -> str:

        use_ascii: bool = not options.supports_unicode
        b_char: str = self.bar_char
        e_char: str = self.empty_char
        if use_ascii:
            b_char = "="
            e_char = "."

        bar_len: int = self.width
        if bar_len < 5:
            bar_len = 5

        pct: int = task.percentage()
        fill_count: int = 0
        if task.total > 0:
            fill_count = task.completed * bar_len // task.total
            if fill_count > bar_len:
                fill_count = bar_len

        empty_count: int = bar_len - fill_count
        if empty_count < 0:
            empty_count = 0

        bar_visual: str = "[" + nox.strings.repeat(b_char, fill_count) + nox.strings.repeat(e_char, empty_count) + "]"
        stats: str = str(pct) + "% (" + str(task.completed) + "/" + str(task.total) + ")"
        if task.total <= 0:
            stats = "(" + str(task.completed) + " items)"

        eta_part: str = ""
        if show_eta and task.total > 0:
            if task.finished:
                eta_part = " [Done in " + format_duration(task.elapsed_seconds()) + "]"
            else:
                eta_part = " [ETA: " + task.format_eta() + "]"

        return bar_visual + " " + stats + eta_part + " " + task.name

    def render_all(self: ProgressBar, options: ConsoleOptions, show_eta: bool = True) -> str:

        lines: list[str] = []
        i: int = 0
        while i < len(self.tasks):
            lines.append(self.render_task(self.tasks[i], options, show_eta))
            i = i + 1
        return nox.strings.join(lines, "\n")

class Spinner:
    frames_unicode: list[str]
    frames_ascii: list[str]
    index: int
    message: str

    def __init__(self: Spinner, message: str = "") -> None:
        self.message = message
        self.frames_unicode = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        self.frames_ascii = ["|", "/", "-", "\\"]
        self.index = 0

    def next_frame(self: Spinner, supports_unicode: bool = True) -> str:

        frame: str = ""
        if supports_unicode:
            frame = self.frames_unicode[self.index % len(self.frames_unicode)]
        else:
            frame = self.frames_ascii[self.index % len(self.frames_ascii)]
        self.index = self.index + 1
        return frame

    def render(self: Spinner, options: ConsoleOptions) -> str:

        if not options.is_tty:
            return "[STATUS] " + self.message
        frame: str = self.next_frame(options.supports_unicode)
        if len(self.message) > 0:
            return frame + " " + self.message
        return frame

class Live:
    console: Console
    transient: bool
    active: bool
    last_text: str
    cursor_hidden: bool

    def __init__(self: Live, console: Console | None = None, transient: bool = False) -> None:
        if console is not None:
            self.console = console
        else:
            self.console = Console()
        self.transient = transient
        self.active = False
        self.last_text = ""
        self.cursor_hidden = False

    def start(self: Live) -> None:

        if self.active:
            return
        self.active = True
        if self.console.options.supports_ansi and self.console.options.is_tty and not self.console.options.capture:
            self.console.write(esc_code() + "[?25l")
            self.cursor_hidden = True

    def update(self: Live, text: str) -> None:

        self.last_text = text
        if not self.console.options.supports_color:
            text = core.strip_ansi(text)
        if self.console.options.capture:
            self.console.buffer = self.console.buffer + text + "\n"
        elif self.console.options.supports_ansi and self.console.options.is_tty:
            nox.terminal.write_raw("\r" + esc_code() + "[2K" + text)
            nox.terminal.flush()
        else:
            self.console.print(text)

    def stop(self: Live) -> None:

        if not self.active:
            return
        self.active = False
        if not self.console.options.capture and self.console.options.supports_ansi and self.console.options.is_tty:
            if self.transient:
                nox.terminal.write_raw("\r" + esc_code() + "[2K")
            else:
                nox.terminal.write_raw("\n")
            if self.cursor_hidden:
                nox.terminal.write_raw(esc_code() + "[?25h")
                self.cursor_hidden = False
            nox.terminal.flush()

    def __enter__(self: Live) -> Live:

        self.start()
        return self

    def __exit__(self: Live) -> None:

        self.stop()

    def __del__(self: Live) -> None:

        self.stop()

def track(items: list[str], description: str = "Working", console: Console | None = None, show_eta: bool = True) -> Iterator[str]:
    con: Console = Console()
    if console is not None:
        con = console
    total: int = len(items)
    bar: ProgressBar = ProgressBar(20)
    task: Task = bar.add_task(description, total)
    for item in items:
        yield item
        task.advance(1)
        if con.options.capture or con.options.is_tty:
            if task.is_finished() or bar.should_render():
                con.print(bar.render_task(task, con.options, show_eta))

def track_range(total: int, description: str = "Working", console: Console | None = None, show_eta: bool = True) -> Iterator[int]:
    con: Console = Console()
    if console is not None:
        con = console
    bar: ProgressBar = ProgressBar(20)
    task: Task = bar.add_task(description, total)
    i: int = 0
    while i < total:
        yield i
        task.advance(1)
        if con.options.capture or con.options.is_tty:
            if task.is_finished() or bar.should_render():
                con.print(bar.render_task(task, con.options, show_eta))
        i = i + 1

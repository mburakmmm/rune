# options.nox — Option and flag definitions with environment, choices, and repetition support.

import arguments
from arguments import ArgType, TYPE_STR, TYPE_INT, TYPE_FLOAT, TYPE_BOOL

class Option:
    name: str
    short_name: str
    opt_type: ArgType
    is_flag: bool
    required: bool
    default_val: str
    help: str
    choices: list[str]
    env_var: str
    multiple: bool
    is_secret: bool

    def __init__(self: Option, name: str, short_name: str = "", opt_type: ArgType | None = None, is_flag: bool = False, required: bool = False, default_val: str = "", help: str = "", choices: list[str] | None = None, env_var: str = "", multiple: bool = False, is_secret: bool = False) -> None:
        self.name = name
        self.short_name = short_name
        if opt_type is not None:
            self.opt_type = opt_type
        else:
            self.opt_type = ArgType.Str
        self.is_flag = is_flag
        self.required = required
        self.default_val = default_val
        self.help = help
        if choices is not None:
            self.choices = choices
        else:
            self.choices = []
        self.env_var = env_var
        self.multiple = multiple
        self.is_secret = is_secret

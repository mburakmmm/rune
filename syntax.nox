# syntax.nox — Lightweight, dependency-free syntax highlighting for terminal code.

import nox.strings
import core
from core import Style, ConsoleOptions, sanitize_ansi

NOX_KEYWORDS: list[str] = [
    "def", "class", "import", "from", "return", "if", "else", "elif",
    "for", "in", "while", "break", "continue", "pass", "raise", "try",
    "except", "finally", "is", "not", "and", "or", "True", "False",
    "None", "self", "let", "fn", "const", "var", "yield", "async",
    "await", "as", "with", "lambda", "match", "case"
]

NOX_BUILTINS: list[str] = [
    "int", "str", "float", "bool", "list", "dict", "tuple", "void",
    "Any", "bytes", "print", "len", "range", "type"
]

TWO_CHAR_OPS: list[str] = [
    "->", "==", "!=", "<=", ">=", "+=", "-=", "*=", "/="
]

def is_alpha(c: str) -> bool:
    if len(c) != 1:
        return False
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")

def is_digit(c: str) -> bool:
    if len(c) != 1:
        return False
    return c >= "0" and c <= "9"

def is_ident_start(c: str) -> bool:
    return is_alpha(c) or c == "_"

def is_ident_part(c: str) -> bool:
    return is_alpha(c) or is_digit(c) or c == "_"

def is_hex_digit(c: str) -> bool:
    return is_digit(c) or (c >= "a" and c <= "f") or (c >= "A" and c <= "F")

class SyntaxTheme:
    keyword: Style
    builtin: Style
    string_lit: Style
    number_lit: Style
    comment: Style
    operator: Style
    gutter: Style

    def __init__(self: SyntaxTheme) -> None:
        self.keyword = Style("magenta", "", True)
        self.builtin = Style("cyan", "", True)
        self.string_lit = Style("green")
        self.number_lit = Style("yellow")
        self.comment = Style("dim")
        self.operator = Style("bright_white")
        self.gutter = Style("dim")

def highlight_line(line: str, theme: SyntaxTheme, language: str) -> str:
    if language != "nox" and language != "python":
        return line

    out: str = ""
    i: int = 0
    n: int = len(line)

    while i < n:
        c: str = line[i]

        # 1. Whitespace
        if c == " " or c == "\t":
            out = out + c
            i = i + 1
            continue

        # 2. Comment: rest of the line
        if c == "#":
            comment_text: str = line[i:n]
            out = out + theme.comment.apply(comment_text)
            break

        # 3. String literals
        if c == "\"" or c == "'":
            q: str = c
            start: int = i
            i = i + 1
            while i < n:
                if line[i] == "\\":
                    i = i + 2
                else:
                    if line[i] == q:
                        i = i + 1
                        break
                    i = i + 1
            str_val: str = line[start:i]
            out = out + theme.string_lit.apply(str_val)
            continue

        # 4. Numbers
        if is_digit(c):
            start_num: int = i
            i = i + 1
            is_hex: bool = False
            if c == "0" and i < n:
                if line[i] == "x" or line[i] == "X":
                    is_hex = True
                    i = i + 1

            while i < n:
                ch: str = line[i]
                if is_hex:
                    if is_hex_digit(ch) or ch == "_":
                        i = i + 1
                    else:
                        break
                else:
                    if is_digit(ch) or ch == "." or ch == "_":
                        i = i + 1
                    else:
                        break
            num_val: str = line[start_num:i]
            out = out + theme.number_lit.apply(num_val)
            continue

        # 5. Identifiers and Keywords
        if is_ident_start(c):
            start_id: int = i
            i = i + 1
            while i < n:
                if is_ident_part(line[i]):
                    i = i + 1
                else:
                    break
            word: str = line[start_id:i]
            if word in NOX_KEYWORDS:
                out = out + theme.keyword.apply(word)
            else:
                if word in NOX_BUILTINS:
                    out = out + theme.builtin.apply(word)
                else:
                    out = out + word
            continue

        # 6. Two-character operators
        if i + 1 < n:
            op2: str = line[i:i + 2]
            if op2 in TWO_CHAR_OPS:
                out = out + theme.operator.apply(op2)
                i = i + 2
                continue

        # 7. Single-character punctuation or operator
        out = out + theme.operator.apply(c)
        i = i + 1

    return out

class Syntax:
    code: str
    language: str
    line_numbers: bool
    start_line: int
    theme: SyntaxTheme

    def __init__(self: Syntax, code: str, language: str = "nox", line_numbers: bool = False, start_line: int = 1) -> None:
        self.code = code
        self.language = language
        self.line_numbers = line_numbers
        self.start_line = start_line
        self.theme = SyntaxTheme()

    def render(self: Syntax, options: ConsoleOptions) -> str:
        safe_code: str = sanitize_ansi(self.code)
        lines: list[str] = nox.strings.split(safe_code, "\n")
        total_lines: int = len(lines)

        max_num: int = self.start_line + total_lines - 1
        num_w: int = len(str(max_num))
        if num_w < 2:
            num_w = 2

        sep: str = "│"
        if not options.supports_unicode:
            sep = "|"

        res: str = ""
        idx: int = 0
        while idx < total_lines:
            line: str = lines[idx]
            line_no: int = self.start_line + idx

            formatted_line: str = ""
            if not options.supports_color:
                formatted_line = line
            else:
                formatted_line = highlight_line(line, self.theme, self.language)

            if self.line_numbers:
                num_str: str = nox.strings.pad_left(str(line_no), num_w, " ")
                gutter_raw: str = num_str + " " + sep + " "
                gutter: str = gutter_raw
                if options.supports_color:
                    gutter = self.theme.gutter.apply(gutter_raw)
                res = res + gutter + formatted_line
            else:
                res = res + formatted_line

            idx = idx + 1
            if idx < total_lines:
                res = res + "\n"

        return res

def highlight_code(code: str, language: str = "nox", line_numbers: bool = False, options: ConsoleOptions | None = None) -> str:
    opts: ConsoleOptions = ConsoleOptions()
    if options is not None:
        opts = options
    syn: Syntax = Syntax(code, language, line_numbers)
    return syn.render(opts)

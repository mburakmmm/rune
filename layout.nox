# layout.nox — Bounding-box geometry, dataclasses, Direction/ConstraintKind enums, and flex layout solver for Rune TUI.

@dataclass
@derive("copy", "order")
class Size:
    width: int
    height: int

@dataclass
@derive("copy")
class Padding:
    top: int
    right: int
    bottom: int
    left: int

class Rect:
    x: int
    y: int
    width: int
    height: int

    def __init__(self: Rect, x: int = 0, y: int = 0, width: int = 0, height: int = 0) -> None:
        if width < 0:
            width = 0
        if height < 0:
            height = 0
        self.x = x
        self.y = y
        self.width = width
        self.height = height

    @property
    def right(self: Rect) -> int:

        return self.x + self.width

    @property
    def bottom(self: Rect) -> int:

        return self.y + self.height

    @property
    def bounds(self: Rect) -> Size:

        return Size(self.width, self.height)

    @property
    def empty(self: Rect) -> bool:

        return self.width <= 0 or self.height <= 0

    def area(self: Rect) -> int:

        return self.width * self.height

    def is_empty(self: Rect) -> bool:

        return self.width <= 0 or self.height <= 0

    def contains(self: Rect, px: int, py: int) -> bool:

        return px >= self.x and px < self.x + self.width and py >= self.y and py < self.y + self.height

    def inner(self: Rect, margin: int) -> Rect:

        if margin <= 0:
            return Rect(self.x, self.y, self.width, self.height)
        new_w: int = self.width - margin * 2
        new_h: int = self.height - margin * 2
        if new_w < 0:
            new_w = 0
        if new_h < 0:
            new_h = 0
        return Rect(self.x + margin, self.y + margin, new_w, new_h)

    def inner_xy(self: Rect, margin_x: int, margin_y: int) -> Rect:

        new_w: int = self.width - margin_x * 2
        new_h: int = self.height - margin_y * 2
        if new_w < 0:
            new_w = 0
        if new_h < 0:
            new_h = 0
        return Rect(self.x + margin_x, self.y + margin_y, new_w, new_h)

    def inner_padding(self: Rect, pad: Padding) -> Rect:

        new_w: int = self.width - pad.left - pad.right
        new_h: int = self.height - pad.top - pad.bottom
        if new_w < 0:
            new_w = 0
        if new_h < 0:
            new_h = 0
        return Rect(self.x + pad.left, self.y + pad.top, new_w, new_h)

    def intersection(self: Rect, other: Rect) -> Rect:

        x1: int = self.x
        if other.x > x1:
            x1 = other.x
        y1: int = self.y
        if other.y > y1:
            y1 = other.y
        x2: int = self.x + self.width
        if other.x + other.width < x2:
            x2 = other.x + other.width
        y2: int = self.y + self.height
        if other.y + other.height < y2:
            y2 = other.y + other.height
        w: int = x2 - x1
        h: int = y2 - y1
        if w < 0:
            w = 0
        if h < 0:
            h = 0
        return Rect(x1, y1, w, h)

    def union(self: Rect, other: Rect) -> Rect:

        if self.is_empty():
            return Rect(other.x, other.y, other.width, other.height)
        if other.is_empty():
            return Rect(self.x, self.y, self.width, self.height)
        x1: int = self.x
        if other.x < x1:
            x1 = other.x
        y1: int = self.y
        if other.y < y1:
            y1 = other.y
        x2: int = self.x + self.width
        if other.x + other.width > x2:
            x2 = other.x + other.width
        y2: int = self.y + self.height
        if other.y + other.height > y2:
            y2 = other.y + other.height
        return Rect(x1, y1, x2 - x1, y2 - y1)

enum ConstraintKind:
    Length(n: int)
    Percentage(pct: int)
    Ratio(num: int, den: int)
    Min(n: int)
    Max(n: int)

class Constraint:
    spec: ConstraintKind

    def __init__(self: Constraint, spec: ConstraintKind) -> None:
        self.spec = spec

    @property
    def is_fixed(self: Constraint) -> bool:

        match self.spec:
            case ConstraintKind.Length(_):
                return True
            case ConstraintKind.Max(_):
                return True
            case ConstraintKind.Percentage(_):
                return False
            case ConstraintKind.Ratio(_, _):
                return False
            case ConstraintKind.Min(_):
                return False

def length_constraint(n: int) -> Constraint:
    if n < 0:
        n = 0
    return Constraint(ConstraintKind.Length(n))

def percentage_constraint(p: int) -> Constraint:
    if p < 0:
        p = 0
    if p > 100:
        p = 100
    return Constraint(ConstraintKind.Percentage(p))

def ratio_constraint(num: int, den: int) -> Constraint:
    if den <= 0:
        den = 1
    if num < 0:
        num = 0
    return Constraint(ConstraintKind.Ratio(num, den))

def min_constraint(n: int) -> Constraint:
    if n < 0:
        n = 0
    return Constraint(ConstraintKind.Min(n))

def max_constraint(n: int) -> Constraint:
    if n < 0:
        n = 0
    return Constraint(ConstraintKind.Max(n))

enum Direction:
    Vertical
    Horizontal

DIRECTION_VERTICAL: Direction = Direction.Vertical
DIRECTION_HORIZONTAL: Direction = Direction.Horizontal

class Layout:
    direction: Direction
    margin: int
    spacing: int
    constraints: list[Constraint]

    def __init__(self: Layout, direction: Direction | None = None, margin: int = 0, spacing: int = 0) -> None:
        if direction is not None:
            self.direction = direction
        else:
            self.direction = Direction.Vertical
        self.margin = margin
        self.spacing = spacing
        self.constraints = []

    def set_direction(self: Layout, direction: Direction) -> Layout:

        self.direction = direction
        return self

    def set_margin(self: Layout, margin: int) -> Layout:

        if margin < 0:
            margin = 0
        self.margin = margin
        return self

    def set_spacing(self: Layout, spacing: int) -> Layout:

        if spacing < 0:
            spacing = 0
        self.spacing = spacing
        return self

    def add_constraint(self: Layout, c: Constraint) -> Layout:

        self.constraints.append(c)
        return self

    def add_constraints(self: Layout, *items: Constraint) -> Layout:

        for item in items:
            self.constraints.append(item)
        return self

    def split_constraints(self: Layout, area: Rect, *items: Constraint) -> list[Rect]:

        saved: list[Constraint] = self.constraints
        self.constraints = []
        for item in items:
            self.constraints.append(item)
        res: list[Rect] = self.split(area)
        self.constraints = saved
        return res

    def split(self: Layout, area: Rect) -> list[Rect]:

        n: int = len(self.constraints)
        if n == 0:
            return []
        target_area: Rect = area
        if self.margin > 0:
            target_area = area.inner(self.margin)

        total_size: int = 0
        match self.direction:
            case Direction.Vertical:
                total_size = target_area.height
            case Direction.Horizontal:
                total_size = target_area.width

        total_spacing: int = 0
        if n > 1 and self.spacing > 0:
            total_spacing = (n - 1) * self.spacing
        available_size: int = total_size - total_spacing
        if available_size < 0:
            available_size = 0

        # Step 1: calculate base sizes using exhaustive match over ConstraintKind
        sizes: list[int] = []
        flexible_indices: list[int] = []
        allocated_total: int = 0

        for i, c in enumerate(self.constraints):
            sz: int = 0
            match c.spec:
                case ConstraintKind.Length(val):
                    sz = val
                case ConstraintKind.Percentage(pct):
                    sz = available_size * pct // 100
                case ConstraintKind.Ratio(num, den):
                    sz = available_size * num // den
                case ConstraintKind.Max(cap):
                    sz = cap
                    if sz > available_size:
                        sz = available_size
                case ConstraintKind.Min(min_val):
                    sz = min_val
                    flexible_indices.append(i)
            sizes.append(sz)
            allocated_total = allocated_total + sz

        # Step 2: distribute remaining space or clamp overallocation
        remaining: int = available_size - allocated_total
        if remaining > 0:
            flex_len: int = len(flexible_indices)
            if flex_len > 0:
                extra_per_flex: int = remaining // flex_len
                rem_extra: int = remaining % flex_len
                for f_idx, target_idx in enumerate(flexible_indices):
                    bonus: int = extra_per_flex
                    if f_idx < rem_extra:
                        bonus = bonus + 1
                    sizes[target_idx] = sizes[target_idx] + bonus
            else:
                expand_idx: int = -1
                chk: int = n - 1
                while chk >= 0:
                    if not self.constraints[chk].is_fixed:
                        expand_idx = chk
                        break
                    chk = chk - 1
                if expand_idx >= 0:
                    sizes[expand_idx] = sizes[expand_idx] + remaining
        elif remaining < 0:
            deficit: int = -remaining
            shrink_idx: int = n - 1
            while shrink_idx >= 0 and deficit > 0:
                current_sz: int = sizes[shrink_idx]
                if current_sz > 0:
                    shrink_amt: int = current_sz
                    if shrink_amt > deficit:
                        shrink_amt = deficit
                    sizes[shrink_idx] = current_sz - shrink_amt
                    deficit = deficit - shrink_amt
                shrink_idx = shrink_idx - 1

        # Step 3: convert sizes into Rect list
        res: list[Rect] = []
        cur_pos: int = 0
        limit_pos: int = 0
        match self.direction:
            case Direction.Vertical:
                cur_pos = target_area.y
                limit_pos = target_area.y + target_area.height
            case Direction.Horizontal:
                cur_pos = target_area.x
                limit_pos = target_area.x + target_area.width

        for chunk_sz in sizes:
            if cur_pos + chunk_sz > limit_pos:
                chunk_sz = limit_pos - cur_pos
            if chunk_sz < 0:
                chunk_sz = 0
            child_rect: Rect = Rect()
            match self.direction:
                case Direction.Vertical:
                    child_rect = Rect(target_area.x, cur_pos, target_area.width, chunk_sz)
                case Direction.Horizontal:
                    child_rect = Rect(cur_pos, target_area.y, chunk_sz, target_area.height)
            res.append(child_rect)
            cur_pos = cur_pos + chunk_sz + self.spacing
            if cur_pos > limit_pos:
                cur_pos = limit_pos

        return res

# core.nox — Terminal capabilities, styling primitives, ANSI sanitization and Console context.

import nox.strings
import nox.os
from nox.os import OsError
import nox.terminal
import nox.unicode

__all__: list[str] = ["esc_code", "reset_code", "clamp_byte", "color_256", "bg_256", "color_rgb", "bg_rgb", "hex_to_rgb", "hex_to_bg_rgb", "resolve_color_code", "resolve_bg_code", "Style", "strip_ansi", "sanitize_ansi", "char_width", "normalize_text", "upper_tr", "lower_tr", "cell_width", "truncate", "wrap_text", "get_env_safe", "ConsoleOptions", "detect_console_options", "Console"]

# ASCII Escape Byte
def esc_code() -> str:
    return nox.strings.char_from_byte(27)

def reset_code() -> str:
    return esc_code() + "[0m"

# Standard Color Constants
COLOR_DEFAULT: str = "39"
COLOR_BLACK: str = "30"
COLOR_RED: str = "31"
COLOR_GREEN: str = "32"
COLOR_YELLOW: str = "33"
COLOR_BLUE: str = "34"
COLOR_MAGENTA: str = "35"
COLOR_CYAN: str = "36"
COLOR_WHITE: str = "37"
COLOR_BRIGHT_BLACK: str = "90"
COLOR_BRIGHT_RED: str = "91"
COLOR_BRIGHT_GREEN: str = "92"
COLOR_BRIGHT_YELLOW: str = "93"
COLOR_BRIGHT_BLUE: str = "94"
COLOR_BRIGHT_MAGENTA: str = "95"
COLOR_BRIGHT_CYAN: str = "96"
COLOR_BRIGHT_WHITE: str = "97"

BG_DEFAULT: str = "49"
BG_BLACK: str = "40"
BG_RED: str = "41"
BG_GREEN: str = "42"
BG_YELLOW: str = "43"
BG_BLUE: str = "44"
BG_MAGENTA: str = "45"
BG_CYAN: str = "46"
BG_WHITE: str = "47"

def clamp_byte(val: int) -> int:
    if val < 0:
        return 0
    if val > 255:
        return 255
    return val

def color_256(n: int) -> str:
    return "38;5;" + str(clamp_byte(n))

def bg_256(n: int) -> str:
    return "48;5;" + str(clamp_byte(n))

def color_rgb(r: int, g: int, b: int) -> str:
    return "38;2;" + str(clamp_byte(r)) + ";" + str(clamp_byte(g)) + ";" + str(clamp_byte(b))

def bg_rgb(r: int, g: int, b: int) -> str:
    return "48;2;" + str(clamp_byte(r)) + ";" + str(clamp_byte(g)) + ";" + str(clamp_byte(b))

def _is_hex_char(ch: str) -> bool:
    if len(ch) != 1:
        return False
    b: int = ord(ch)
    return b >= 48 and b <= 57 or b >= 65 and b <= 70 or b >= 97 and b <= 102

def _hex_digit(ch: str) -> int:
    b: int = ord(ch)
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 65 and b <= 70:
        return b - 55
    if b >= 97 and b <= 102:
        return b - 87
    return 0

def hex_to_rgb(hex_str: str) -> str:
    s: str = nox.strings.trim(hex_str)
    if nox.strings.starts_with(s, "#"):
        s = s[1:]
    if len(s) == 6:
        if not _is_hex_char(s[0]) or not _is_hex_char(s[1]) or not _is_hex_char(s[2]) or not _is_hex_char(s[3]) or not _is_hex_char(s[4]) or not _is_hex_char(s[5]):
            return ""
        r: int = _hex_digit(s[0]) * 16 + _hex_digit(s[1])
        g: int = _hex_digit(s[2]) * 16 + _hex_digit(s[3])
        b: int = _hex_digit(s[4]) * 16 + _hex_digit(s[5])
        return color_rgb(r, g, b)
    return ""

def hex_to_bg_rgb(hex_str: str) -> str:
    s: str = nox.strings.trim(hex_str)
    if nox.strings.starts_with(s, "#"):
        s = s[1:]
    if len(s) == 6:
        if not _is_hex_char(s[0]) or not _is_hex_char(s[1]) or not _is_hex_char(s[2]) or not _is_hex_char(s[3]) or not _is_hex_char(s[4]) or not _is_hex_char(s[5]):
            return ""
        r: int = _hex_digit(s[0]) * 16 + _hex_digit(s[1])
        g: int = _hex_digit(s[2]) * 16 + _hex_digit(s[3])
        b: int = _hex_digit(s[4]) * 16 + _hex_digit(s[5])
        return bg_rgb(r, g, b)
    return ""

def _is_safe_sgr_params(s: str) -> bool:
    if len(s) == 0:
        return False
    i: int = 0
    while i < len(s):
        c: str = s[i]
        if not (c >= "0" and c <= "9") and c != ";":
            return False
        i = i + 1
    return True

def resolve_color_code(name: str) -> str:
    clean: str = nox.strings.lower(nox.strings.trim(name))
    if nox.strings.starts_with(clean, "#"):
        return hex_to_rgb(clean)
    if nox.strings.contains(clean, ";"):
        if _is_safe_sgr_params(clean):
            return clean
        return ""
    match clean:
        case "black":
            return COLOR_BLACK
        case "red":
            return COLOR_RED
        case "green":
            return COLOR_GREEN
        case "yellow":
            return COLOR_YELLOW
        case "blue":
            return COLOR_BLUE
        case "magenta" | "purple":
            return COLOR_MAGENTA
        case "cyan":
            return COLOR_CYAN
        case "white":
            return COLOR_WHITE
        case "gray" | "grey" | "bright_black":
            return COLOR_BRIGHT_BLACK
        case "bright_red":
            return COLOR_BRIGHT_RED
        case "bright_green":
            return COLOR_BRIGHT_GREEN
        case "bright_yellow":
            return COLOR_BRIGHT_YELLOW
        case "bright_blue":
            return COLOR_BRIGHT_BLUE
        case "bright_magenta":
            return COLOR_BRIGHT_MAGENTA
        case "bright_cyan":
            return COLOR_BRIGHT_CYAN
        case "bright_white":
            return COLOR_BRIGHT_WHITE
        case _:
            return ""

def resolve_bg_code(name: str) -> str:
    clean: str = nox.strings.lower(nox.strings.trim(name))
    if nox.strings.starts_with(clean, "#"):
        return hex_to_bg_rgb(clean)
    if nox.strings.contains(clean, ";"):
        if _is_safe_sgr_params(clean):
            return clean
        return ""
    match clean:
        case "black":
            return BG_BLACK
        case "red":
            return BG_RED
        case "green":
            return BG_GREEN
        case "yellow":
            return BG_YELLOW
        case "blue":
            return BG_BLUE
        case "magenta" | "purple":
            return BG_MAGENTA
        case "cyan":
            return BG_CYAN
        case "white":
            return BG_WHITE
        case _:
            return ""

class Style:
    def __init__(self: Style, fg: str = "", bg: str = "", bold: bool = False, dim: bool = False, italic: bool = False, underline: bool = False, reverse: bool = False) -> None:
        self.fg = fg
        self.bg = bg
        self.bold = bold
        self.dim = dim
        self.italic = italic
        self.underline = underline
        self.reverse = reverse

    def is_plain(self: Style) -> bool:

        if len(self.fg) > 0:
            return False
        if len(self.bg) > 0:
            return False
        if self.bold or self.dim or self.italic or self.underline or self.reverse:
            return False
        return True

    def to_ansi(self: Style) -> str:

        if self.is_plain():
            return ""
        codes: list[str] = []
        if self.bold:
            codes.append("1")
        if self.dim:
            codes.append("2")
        if self.italic:
            codes.append("3")
        if self.underline:
            codes.append("4")
        if self.reverse:
            codes.append("7")

        if len(self.fg) > 0:
            fg_code: str = resolve_color_code(self.fg)
            if len(fg_code) > 0:
                codes.append(fg_code)
            else:
                codes.append(self.fg)

        if len(self.bg) > 0:
            bg_code: str = resolve_bg_code(self.bg)
            if len(bg_code) > 0:
                codes.append(bg_code)
            else:
                codes.append(self.bg)

        if len(codes) == 0:
            return ""
        return esc_code() + "[" + nox.strings.join(codes, ";") + "m"

    def apply(self: Style, text: str) -> str:

        if self.is_plain() or len(text) == 0:
            return text
        return self.to_ansi() + text + reset_code()

def strip_ansi(s: str) -> str:
    n: int = len(s)
    if n == 0:
        return ""
    parts: list[str] = []
    span_start: int = 0
    i: int = 0
    while i < n:
        code: int = ord(s[i])
        if code == 27:
            if i > span_start:
                parts.append(s[span_start:i])
            i = i + 1
            if i < n:
                next_ch: str = s[i]
                if next_ch == "[":
                    i = i + 1
                    while i < n:
                        cb: int = ord(s[i])
                        if cb >= 64 and cb <= 126:
                            i = i + 1
                            break
                        i = i + 1
                elif next_ch == "]":
                    i = i + 1
                    while i < n:
                        cb: int = ord(s[i])
                        if cb == 7:
                            i = i + 1
                            break
                        if cb == 27 and i + 1 < n and s[i + 1] == "\\":
                            i = i + 2
                            break
                        i = i + 1
                else:
                    i = i + 1
            span_start = i
        else:
            i = i + 1
    if span_start == 0:
        return s
    if span_start < n:
        parts.append(s[span_start:n])
    if len(parts) == 0:
        return ""
    return nox.strings.join(parts, "")

def sanitize_ansi(s: str) -> str:
    # Completely strips escape codes, C0 controls (except \n, \t), C1 controls (128-159), and standalone \r
    n: int = len(s)
    if n == 0:
        return ""
    parts: list[str] = []
    span_start: int = 0
    i: int = 0
    while i < n:
        code: int = ord(s[i])

        # 1. ESC sequences
        if code == 27:
            if i > span_start:
                parts.append(s[span_start:i])
            i = i + 1
            if i < n:
                next_ch: str = s[i]
                if next_ch == "[":
                    i = i + 1
                    while i < n:
                        cb: int = ord(s[i])
                        if cb >= 64 and cb <= 126:
                            i = i + 1
                            break
                        i = i + 1
                elif next_ch == "]":
                    i = i + 1
                    while i < n:
                        cb: int = ord(s[i])
                        if cb == 7:
                            i = i + 1
                            break
                        if cb == 27 and i + 1 < n and s[i + 1] == "\\":
                            i = i + 2
                            break
                        i = i + 1
                else:
                    i = i + 1
            span_start = i
            continue

        # 2. C1 control codes (0x80 to 0x9F / 128 to 159) & DEL (127)
        if code == 127 or code >= 128 and code <= 159:
            if i > span_start:
                parts.append(s[span_start:i])
            i = i + 1
            span_start = i
            continue

        # 3. Carriage return handling (\r\n -> \n, standalone \r dropped to prevent line overwrite spoofing)
        if code == 13:
            if i > span_start:
                parts.append(s[span_start:i])
            if i + 1 < n and ord(s[i + 1]) == 10:
                parts.append("\n")
                i = i + 2
            else:
                i = i + 1
            span_start = i
            continue

        # 4. Other C0 control characters (reject all < 32 except \n and \t)
        if code < 32 and code != 10 and code != 9:
            if i > span_start:
                parts.append(s[span_start:i])
            i = i + 1
            span_start = i
            continue

        i = i + 1

    if span_start == 0:
        return s
    if span_start < n:
        parts.append(s[span_start:n])
    if len(parts) == 0:
        return ""
    return nox.strings.join(parts, "")

def char_width(c: str) -> int:
    cp: int = ord(c)
    # C0, C1, and DEL controls
    if cp < 32 or cp >= 127 and cp <= 159:
        return 0
    # Zero width combining & format characters (VS1-16, ZWJ, ZWNJ, etc.)
    if cp >= 768 and cp <= 879 or cp >= 6832 and cp <= 6911 or cp >= 7616 and cp <= 7679 or cp >= 8400 and cp <= 8447 or cp >= 65024 and cp <= 65039 or cp >= 65056 and cp <= 65071:
        return 0
    if cp == 8203 or cp == 8204 or cp == 8205 or cp == 8206 or cp == 8207:
        return 0
    # CJK Wide and Fullwidth characters (width 2)
    if cp >= 4352 and cp <= 4447 or cp >= 11904 and cp <= 12287 or cp >= 12288 and cp <= 12350 or cp >= 12352 and cp <= 12543 or cp >= 12592 and cp <= 12799 or cp >= 13312 and cp <= 19903 or cp >= 19968 and cp <= 40959 or cp >= 43360 and cp <= 43391 or cp >= 44032 and cp <= 55203 or cp >= 55216 and cp <= 55295 or cp >= 63744 and cp <= 64255 or cp >= 65281 and cp <= 65376 or cp >= 65504 and cp <= 65510 or cp >= 131072 and cp <= 262141:
        return 2
    # Emojis and Pictographs (width 2 in modern terminals)
    if cp >= 127744 and cp <= 128767 or cp >= 128512 and cp <= 128591 or cp >= 128640 and cp <= 128767 or cp >= 129280 and cp <= 129535 or cp >= 129648 and cp <= 129791 or cp >= 9728 and cp <= 10175:
        return 2
    return 1

def normalize_text(s: str, form: str = "NFC") -> str:
    return nox.unicode.normalize(s, form)

def upper_tr(s: str) -> str:
    return nox.unicode.upper_tr(s)

def lower_tr(s: str) -> str:
    return nox.unicode.lower_tr(s)

def cell_width(s: str) -> int:
    raw_clean: str = strip_ansi(s)
    bn: int = nox.strings.byte_len(raw_clean)
    if bn == 0:
        return 0
    bi: int = 0
    while bi < bn:
        b: int = nox.strings.byte_at(raw_clean, bi)
        if b < 32 or b >= 127:
            break
        bi = bi + 1
    else:
        return bn

    clean: str = nox.unicode.normalize(raw_clean, "NFC")
    w: int = 0
    i: int = 0
    n: int = len(clean)
    while i < n:
        w = w + char_width(clean[i])
        i = i + 1
    return w

def truncate(s: str, max_width: int, ellipsis: str = "...") -> str:
    cw: int = cell_width(s)
    if cw <= max_width:
        return s
    ew: int = cell_width(ellipsis)
    if max_width <= ew:
        return ""
    target: int = max_width - ew
    clean: str = strip_ansi(s)
    acc_w: int = 0
    i: int = 0
    n: int = len(clean)
    while i < n:
        ch_w: int = char_width(clean[i])
        if acc_w + ch_w > target:
            break
        acc_w = acc_w + ch_w
        i = i + 1
    return clean[:i] + ellipsis

def wrap_text(s: str, max_width: int) -> list[str]:
    lines: list[str] = []
    if max_width <= 0:
        lines.append(s)
        return lines

    raw_paragraphs: list[str] = nox.strings.split(s, "\n")
    p_idx: int = 0
    while p_idx < len(raw_paragraphs):
        para: str = raw_paragraphs[p_idx]
        if len(para) == 0:
            lines.append("")
            p_idx = p_idx + 1
            continue

        words: list[str] = nox.strings.split(para, " ")
        cur_line: str = ""
        w_idx: int = 0
        while w_idx < len(words):
            word: str = words[w_idx]
            w_len: int = cell_width(word)

            if len(cur_line) == 0:
                if w_len > max_width:
                    chunk_str: str = ""
                    chunk_w: int = 0
                    ch_idx: int = 0
                    while ch_idx < len(word):
                        c: str = word[ch_idx]
                        cw: int = char_width(c)
                        if chunk_w + cw > max_width and len(chunk_str) > 0:
                            lines.append(chunk_str)
                            chunk_str = c
                            chunk_w = cw
                        else:
                            chunk_str = chunk_str + c
                            chunk_w = chunk_w + cw
                        ch_idx = ch_idx + 1
                    cur_line = chunk_str
                else:
                    cur_line = word
            else:
                if cell_width(cur_line) + 1 + w_len <= max_width:
                    cur_line = cur_line + " " + word
                else:
                    lines.append(cur_line)
                    if w_len > max_width:
                        chunk_str2: str = ""
                        chunk_w2: int = 0
                        ch_idx2: int = 0
                        while ch_idx2 < len(word):
                            c2: str = word[ch_idx2]
                            cw2: int = char_width(c2)
                            if chunk_w2 + cw2 > max_width and len(chunk_str2) > 0:
                                lines.append(chunk_str2)
                                chunk_str2 = c2
                                chunk_w2 = cw2
                            else:
                                chunk_str2 = chunk_str2 + c2
                                chunk_w2 = chunk_w2 + cw2
                            ch_idx2 = ch_idx2 + 1
                        cur_line = chunk_str2
                    else:
                        cur_line = word
            w_idx = w_idx + 1

        if len(cur_line) > 0:
            lines.append(cur_line)
        p_idx = p_idx + 1

    return lines

def get_env_safe(key: str) -> str | None:
    try:
        val: str = nox.os.getenv(key)
        return val
    except OsError:
        return None

class ConsoleOptions:
    supports_color: bool
    supports_unicode: bool
    width: int
    height: int
    is_tty: bool
    capture: bool
    supports_ansi: bool
    color_depth: int
    supports_truecolor: bool

    def __init__(self: ConsoleOptions, supports_color: bool = True, supports_unicode: bool = True, width: int = 80, height: int = 24, is_tty: bool = True, capture: bool = False, supports_ansi: bool = True, color_depth: int = -1, supports_truecolor: bool = False) -> None:
        self.supports_color = supports_color
        self.supports_unicode = supports_unicode
        self.width = width
        self.height = height
        self.is_tty = is_tty
        self.capture = capture
        self.supports_ansi = supports_ansi
        if color_depth >= 0:
            self.color_depth = color_depth
            self.supports_truecolor = supports_truecolor or color_depth >= 16777216
        elif not supports_color:
            self.color_depth = 0
            self.supports_truecolor = False
        elif supports_truecolor:
            self.color_depth = 16777216
            self.supports_truecolor = True
        else:
            self.color_depth = 16
            self.supports_truecolor = False

    @property
    def is_plain(self: ConsoleOptions) -> bool:

        return not self.supports_color and not self.supports_ansi

def detect_console_options() -> ConsoleOptions:
    caps: nox.terminal.TerminalCapabilities = nox.terminal.get_capabilities()
    sz: nox.terminal.TerminalSize = nox.terminal.get_size()

    no_color: str | None = get_env_safe("NO_COLOR")
    force_color: str | None = get_env_safe("CLICOLOR_FORCE")
    term: str | None = get_env_safe("TERM")
    ci: str | None = get_env_safe("CI")

    os_env: str | None = get_env_safe("OS")
    wt_session: str | None = get_env_safe("WT_SESSION")
    ansicon: str | None = get_env_safe("ANSICON")
    conemu: str | None = get_env_safe("ConEmuANSI")

    is_tty: bool = caps.is_tty
    if ci is not None and len(ci) > 0:
        is_tty = False

    supports_ansi: bool = caps.supports_ansi
    supports_color: bool = caps.supports_ansi
    supports_unicode: bool = True
    color_depth: int = caps.color_depth
    supports_truecolor: bool = caps.supports_truecolor

    if os_env is not None and os_env == "Windows_NT":
        is_modern_win: bool = wt_session is not None or ansicon is not None or conemu is not None
        if not is_modern_win:
            supports_unicode = False
            supports_color = False
            supports_ansi = False
            color_depth = 0
            supports_truecolor = False

    if no_color is not None and len(no_color) > 0:
        supports_color = False
        color_depth = 0
        supports_truecolor = False
    elif force_color is not None and force_color == "1":
        supports_color = True
        supports_ansi = True
        if color_depth == 0:
            color_depth = 16
    elif term is not None and term == "dumb":
        supports_color = False
        supports_ansi = False
        color_depth = 0
        supports_truecolor = False

    term_width: int = sz.cols
    if term_width <= 0:
        term_width = 80
    term_height: int = sz.rows
    if term_height <= 0:
        term_height = 24

    return ConsoleOptions(supports_color, supports_unicode, term_width, term_height, is_tty, False, supports_ansi, color_depth, supports_truecolor)

class Console:
    options: ConsoleOptions
    buffer: str

    def __init__(self: Console, options: ConsoleOptions | None = None) -> None:
        if options is not None:
            self.options = options
        else:
            self.options = detect_console_options()
        self.buffer = ""

    def print(self: Console, text: str = "") -> None:

        if not self.options.supports_color:
            text = strip_ansi(text)
        if self.options.capture:
            self.buffer = self.buffer + text + "\n"
        else:
            print(text)

    def print_styled(self: Console, text: str, style: Style) -> None:

        if self.options.supports_color:
            self.print(style.apply(text))
        else:
            self.print(text)

    def print_items(self: Console, *items: str) -> None:

        parts: list[str] = []
        for it in items:
            parts.append(it)
        self.print(nox.strings.join(parts, " "))

    def write(self: Console, text: str) -> None:

        if not self.options.supports_color:
            text = strip_ansi(text)
        if self.options.capture:
            self.buffer = self.buffer + text
        else:
            nox.terminal.write_raw(text)
            nox.terminal.flush()

    def get_captured(self: Console) -> str:

        return self.buffer

    def clear_captured(self: Console) -> None:

        self.buffer = ""

    def set_color(self: Console, enabled: bool) -> None:

        self.options.supports_color = enabled

    def set_width(self: Console, width: int) -> None:

        if width > 0:
            self.options.width = width

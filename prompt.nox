# prompt.nox — Safe, non-blocking-capable interactive prompts, validation, and multi-selection.

import nox.strings
import core
from core import Console, ConsoleOptions, Style

class PromptError(Exception):
    pass

class NonInteractiveError(PromptError):
    pass

def prompt_text(
    question: str,
    default_val: str = "",
    console: Console | None = None
) -> str:
    con: Console = Console()
    if console is not None:
        con = console

    if not con.options.is_tty:
        if len(default_val) > 0:
            return default_val
        raise NonInteractiveError("Prompt '" + question + "' required input in non-interactive environment without default")

    prompt_msg: str = question
    if len(default_val) > 0:
        prompt_msg = prompt_msg + " [" + default_val + "]: "
    else:
        prompt_msg = prompt_msg + ": "

    con.write(prompt_msg)
    user_input: str = nox.strings.trim(input())
    if len(user_input) == 0:
        return default_val
    return user_input

def prompt_int(
    question: str,
    default_val: int | None = None,
    min_val: int | None = None,
    max_val: int | None = None,
    max_retries: int = 3,
    console: Console | None = None
) -> int:
    con: Console = Console()
    if console is not None:
        con = console

    if not con.options.is_tty:
        if default_val is not None:
            return default_val
        if min_val is not None:
            return min_val
        return 0

    attempt: int = 0
    while attempt < max_retries:
        suffix: str = ""
        if default_val is not None:
            suffix = " [" + str(default_val) + "]: "
        else:
            suffix = ": "

        con.write(question + suffix)
        raw_val: str = nox.strings.trim(input())
        if len(raw_val) == 0:
            if default_val is not None:
                return default_val

        try:
            parsed: int = int(raw_val)
            valid: bool = True
            if min_val is not None:
                if parsed < min_val:
                    valid = False
            if max_val is not None:
                if parsed > max_val:
                    valid = False

            if valid:
                return parsed
            else:
                con.print_styled("Value out of allowed range.", Style("red"))
        except ValueError:
            con.print_styled("Please enter a valid integer.", Style("red"))

        attempt = attempt + 1

    raise PromptError("Maximum retries exceeded for prompt: " + question)

def confirm(
    question: str,
    default_val: bool = True,
    console: Console | None = None
) -> bool:
    con: Console = Console()
    if console is not None:
        con = console

    if not con.options.is_tty:
        return default_val

    suffix: str = "[Y/n]: "
    if not default_val:
        suffix = "[y/N]: "

    con.write(question + " " + suffix)
    ans: str = nox.strings.lower(nox.strings.trim(input()))
    if len(ans) == 0:
        return default_val
    if ans == "y" or ans == "yes" or ans == "true" or ans == "1":
        return True
    if ans == "n" or ans == "no" or ans == "false" or ans == "0":
        return False
    return default_val

def select_choice(
    question: str,
    choices: list[str],
    default_val: str = "",
    console: Console | None = None
) -> str:
    con: Console = Console()
    if console is not None:
        con = console

    if len(choices) == 0:
        return default_val

    if not con.options.is_tty:
        if len(default_val) > 0:
            return default_val
        return choices[0]

    con.print(question)
    i: int = 0
    while i < len(choices):
        con.print("  " + str(i + 1) + ") " + choices[i])
        i = i + 1

    suffix: str = "Choose [1-" + str(len(choices)) + "]: "
    if len(default_val) > 0:
        suffix = "Choose [1-" + str(len(choices)) + ", default=" + default_val + "]: "

    con.write(suffix)
    user_raw: str = nox.strings.trim(input())
    if len(user_raw) == 0:
        if len(default_val) > 0:
            return default_val
        return choices[0]

    # Try numeric match
    try:
        idx: int = int(user_raw)
        if idx >= 1 and idx <= len(choices):
            return choices[idx - 1]
    except ValueError:
        pass

    # Try exact string match
    j: int = 0
    while j < len(choices):
        if choices[j] == user_raw:
            return choices[j]
        j = j + 1

    if len(default_val) > 0:
        return default_val
    return choices[0]

def select_multiple(
    question: str,
    choices: list[str],
    default_choices: list[str] | None = None,
    console: Console | None = None
) -> list[str]:
    con: Console = Console()
    if console is not None:
        con = console

    if len(choices) == 0:
        empty: list[str] = []
        return empty

    if not con.options.is_tty:
        if default_choices is not None:
            return default_choices
        first_only: list[str] = [choices[0]]
        return first_only

    con.print(question)
    i: int = 0
    while i < len(choices):
        con.print("  " + str(i + 1) + ") " + choices[i])
        i = i + 1

    con.write("Select comma-separated numbers (e.g. 1, 2) or 'all': ")
    raw_in: str = nox.strings.trim(input())

    if len(raw_in) == 0:
        if default_choices is not None:
            return default_choices
        empty_def: list[str] = []
        return empty_def

    if raw_in == "all":
        return choices

    tokens: list[str] = nox.strings.split(raw_in, ",")
    selected: list[str] = []

    t_idx: int = 0
    while t_idx < len(tokens):
        item: str = nox.strings.trim(tokens[t_idx])
        if len(item) > 0:
            # Check numeric
            matched: bool = False
            try:
                c_num: int = int(item)
                if c_num >= 1 and c_num <= len(choices):
                    chosen: str = choices[c_num - 1]
                    if chosen not in selected:
                        selected.append(chosen)
                    matched = True
            except ValueError:
                pass

            if not matched:
                # Check string match
                c_idx: int = 0
                while c_idx < len(choices):
                    if choices[c_idx] == item:
                        if item not in selected:
                            selected.append(item)
                        break
                    c_idx = c_idx + 1
        t_idx = t_idx + 1

    return selected

def prompt_password(question: str) -> str:
    # Explicitly documented limitation according to AGENTS.md §11
    raise PromptError("Echo-suppressed password input is not currently supported by the Nox runtime")
